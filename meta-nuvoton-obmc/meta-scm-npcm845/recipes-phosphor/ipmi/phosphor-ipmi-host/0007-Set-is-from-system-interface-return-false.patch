From 749fab81436e9238de43914d48d4bb899b31a323 Mon Sep 17 00:00:00 2001
From: Joseph Liu <kwliu@nuvoton.com>
Date: Thu, 14 Aug 2025 10:03:02 +0800
Subject: [PATCH] Set is from system interface return false

Upstream-Status: Inappropriate [oe-specific]

The ipmitool get the event is from system interface return false, but
ipmid set true as default. Change the ipmid default value to send event. Set is from system interface return false

Signed-off-by: Brian Ma <chma0@nuvoton.com>
Signed-off-by: Joseph Liu <kwliu@nuvoton.com>
---
 sensorhandler.cpp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sensorhandler.cpp b/sensorhandler.cpp
index b62e00b8..f6dd1b3d 100644
--- a/sensorhandler.cpp
+++ b/sensorhandler.cpp
@@ -1442,7 +1442,7 @@ static bool isFromSystemChannel()
     // TODO we could not figure out where the request is from based on IPMI
     // command handler parameters. because of it, we can not differentiate
     // request from SMS/SMM or IPMB channel
-    return true;
+    return false;
 }
 
 ipmi::Cc ipmicmdPlatformEvent(ipmi_netfn_t, ipmi_cmd_t, ipmi_request_t request,
-- 
2.43.0

