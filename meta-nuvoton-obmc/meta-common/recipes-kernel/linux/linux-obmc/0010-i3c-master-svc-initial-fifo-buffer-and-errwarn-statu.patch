---
 drivers/i3c/master/svc-i3c-master.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/drivers/i3c/master/svc-i3c-master.c b/drivers/i3c/master/svc-i3c-master.c
index 2ad12a4e0146..6776c49ba88a 100644
