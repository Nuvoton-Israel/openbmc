 {
 	struct list_head *pList;
 	vdm_instance_t *pVDM_Instance;
+	u32 status, rx_data;
+	int size, i;
+
+	status = ioread32(vdm_virt_addr + VDM_STAT_REG_ADDR);
+	iowrite32(status, vdm_virt_addr + VDM_STAT_REG_ADDR);
+	if (status & VDM_RX_FULL_BIT_POS) {
+		list_for_each(pList, &vdm_instances_list)
+		{
+			//pr_debug("<1>vdm:vdm fifo overflowed\n");
+			pVDM_Instance = list_entry(pList, vdm_instance_t, list);
+			pVDM_Instance->last_errors |= PCIE_VDM_ERR_HW_FIFO_OVERFLOW;
+			pr_info("vdma_isr FIFO drop 0x%x\n",status);
+			tasklet_schedule(&vdm_tasklet_with_overflow);
+		}
+		return IRQ_HANDLED;
+	}
+	if (status & VDM_RX_DONE_BIT_POS){
+		size = (status >> 16) & 0xFF;
+		for(i=0; i < size; i++) {
+			rx_data = ioread32(vdm_virt_addr + VDM_RXF_REG_ADDR);
+			kfifo_in(&fifo, &rx_data, sizeof(rx_data));
+		}
+		wake_up_interruptible(&pVDM_Instance->in_data_available_wait);
+		return IRQ_HANDLED;
+	}
+
+	return IRQ_NONE;
 
