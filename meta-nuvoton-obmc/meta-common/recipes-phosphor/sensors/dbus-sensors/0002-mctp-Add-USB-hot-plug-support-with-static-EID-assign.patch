diff --git a/src/mctp/MCTPReactorMain.cpp b/src/mctp/MCTPReactorMain.cpp
index 06d9a0ab5..8f02e245a 100644
--- a/src/mctp/MCTPReactorMain.cpp
+++ b/src/mctp/MCTPReactorMain.cpp
@@ -249,6 +249,42 @@ int main()
         static_cast<sdbusplus::bus_t&>(*systemBus), interfacesAddedMatchSpec,
         std::bind_front(addInventory, systemBus, reactor));
 
+    // When a new mctpd interface appears (e.g. USB inserted after boot),
+    // re-run getConfiguration so USBMCTPDDevice::from() can succeed now
+    // that the sysfs path exists.
+    const std::string mctpdInterfaceAddedSpec =
+        rules::sender("au.com.codeconstruct.MCTP1") +
+        rules::interfacesAddedAtPath(
+            "/au/com/codeconstruct/mctp1/interfaces/");
+
+    auto mctpdInterfaceAddedMatch = sdbusplus::bus::match_t(
+        static_cast<sdbusplus::bus_t&>(*systemBus), mctpdInterfaceAddedSpec,
+        [reactor, systemBus](sdbusplus::message_t& /*msg*/) {
+            info("mctpd interface added, re-running getConfiguration");
+            auto gsc = std::make_shared<GetSensorConfiguration>(
+                systemBus,
+                std::bind_front(manageMCTPEntity, systemBus, reactor));
+            std::vector<std::string_view> types{"MCTPI2CTarget", "MCTPI3CTarget", "MCTPUSBDevice"};
+            gsc->getConfiguration(types);
+        });
+
+    // When a mctpd interface is removed (e.g. USB cable unplugged), stop
+    // retrying setup for devices on that interface so we don't flood mctpd
+    // with pointless AssignEndpointStatic calls.
+    const std::string mctpdInterfaceRemovedSpec =
+        rules::sender("au.com.codeconstruct.MCTP1") +
+        rules::interfacesRemovedAtPath(
+            "/au/com/codeconstruct/mctp1/interfaces/");
+
+    auto mctpdInterfaceRemovedMatch = sdbusplus::bus::match_t(
+        static_cast<sdbusplus::bus_t&>(*systemBus), mctpdInterfaceRemovedSpec,
+        [reactor](sdbusplus::message_t& msg) {
+            auto [objpath, interfaces] =
+                msg.unpack<sdbusplus::object_path, std::set<std::string>>();
+            std::string ifname = objpath.filename();
+            reactor->removeMCTPInterface(ifname);
+        });
+
     systemBus->request_name("xyz.openbmc_project.MCTPReactor");
 
     boost::asio::post(io, [reactor, systemBus]() {
