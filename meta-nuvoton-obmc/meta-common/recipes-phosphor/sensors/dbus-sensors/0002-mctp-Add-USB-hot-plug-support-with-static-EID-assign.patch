+void MCTPReactor::removeMCTPInterface(const std::string& ifname)
+{
+    // When a mctpd interface (e.g. mctpusb0) goes away, remove all devices
+    // using that interface from the repository.  This ensures that when the
+    // interface reappears on a different port and getConfiguration re-runs,
+    // manageMCTPDevice() can add the new device without hitting a stale
+    // path-to-device mapping conflict.
+
+    // Collect matching devices first to avoid modifying the map while
+    // iterating over it.
+    std::vector<std::shared_ptr<MCTPDevice>> toRemove;
+    for (const auto& entry : devices)
+    {
+        auto* mctpd = dynamic_cast<MCTPDDevice*>(entry.second.get());
+        if (mctpd && mctpd->getInterface() == ifname)
+            toRemove.push_back(entry.second);
+    }
+
+    for (const auto& dev : toRemove)
+    {
+        info("mctpd interface '{IFNAME}' removed, removing device "
+             "[ {MCTP_DEVICE} ] from repository",
+             "IFNAME", ifname, "MCTP_DEVICE", dev->describe());
+        devices.remove(dev);
+        states.erase(dev->id());
+    }
+}
+
 void MCTPReactor::unmanageMCTPDevice(const std::string& path)
 {
     auto device = devices.deviceFor(path);
