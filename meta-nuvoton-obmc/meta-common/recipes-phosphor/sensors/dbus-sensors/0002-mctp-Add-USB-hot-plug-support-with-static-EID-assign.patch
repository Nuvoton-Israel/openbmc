@@ -125,6 +125,44 @@ void MCTPDDevice::setup(
         mctpdControlInterface, "AssignEndpoint", physaddr);
 }
 
+void MCTPDDevice::setupWithStaticEid(
+    uint8_t eid,
+    std::function<void(const std::error_code& ec,
+                       const std::shared_ptr<MCTPEndpoint>& ep)>&& added)
+{
+    auto onSetup = [weak{weak_from_this()}, added{std::move(added)}](
+                       const boost::system::error_code& ec, uint8_t eid,
+                       int network, const std::string& objpath,
+                       bool allocated [[maybe_unused]]) mutable {
+        if (ec)
+        {
+            added(ec, {});
+            return;
+        }
+        if (auto self = weak.lock())
+        {
+            self->finaliseEndpoint(objpath, eid, network, added);
+        }
+    };
+    connection->async_method_call(
+        onSetup, mctpdBusName,
+        mctpdControlPath + std::string("/interfaces/") + interface,
+        mctpdControlInterface, "AssignEndpointStatic", physaddr, eid);
+}
+
+void USBMCTPDDevice::setup(
+    std::function<void(const std::error_code& ec,
+                       const std::shared_ptr<MCTPEndpoint>& ep)>&& added)
+{
+    if (!staticEid)
+    {
+        // No static EID configured: delegate to base class (AssignEndpoint)
+        MCTPDDevice::setup(std::move(added));
+        return;
+    }
+    setupWithStaticEid(*staticEid, std::move(added));
+}
+
 void MCTPDDevice::endpointRemoved()
 {
     if (endpoint)
@@ -707,12 +745,31 @@ std::shared_ptr<USBMCTPDDevice> USBMCTPDDevice::from(
         throw std::invalid_argument("Bad Interface value");
     }
 
+    // Optional static EID: if present, AssignEndpointStatic will be used
+    std::optional<uint8_t> staticEid;
+    auto mEID = iface.find("EID");
+    if (mEID != iface.end())
+    {
+        auto sEID = std::visit(VariantToStringVisitor(), mEID->second);
+        uint8_t eid{};
+        auto [eptr, eec] = std::from_chars(sEID.data(),
+                                           sEID.data() + sEID.size(), eid);
+        if (eec != std::errc{})
+        {
+            throw std::invalid_argument("Bad EID value");
+        }
+        staticEid = eid;
+    }
+
     try
     {
         std::string bus = busFromRootHubPath(rootHubPath);
         std::string interface =
             interfaceFromSysfs(bus, port, configuration, interfaceNum);
-        return std::make_shared<USBMCTPDDevice>(connection, interface);
+        info("USBMCTPDDevice::from: port={USB_PORT} -> sysfs iface={SYSFS_IFACE} staticEid={STATIC_EID}",
+             "USB_PORT", port, "SYSFS_IFACE", interface,
+             "STATIC_EID", staticEid ? std::to_string(*staticEid) : "none");
+        return std::make_shared<USBMCTPDDevice>(connection, interface, staticEid);
     }
     catch (const MCTPException& ex)
     {
