[Match]
Name=vport1
MACAddress=02:00:11:22:33:44

[Network]
# vport1 = V-Port 1: HOST Ethernet out of the USB CDC-ECM NIC. It is a switch
# port of the L2 switch (br0) with no BMC-side IP. The Host connected via USB
# obtains its own IP from the upstream DHCP server through br0.
Bridge=br0
LinkLocalAddressing=no
IPv6AcceptRA=no
ConfigureWithoutCarrier=yes
RequiredForOnline=no
