+
+#define FIU_RD_MODE_FAST_RD_DUAL_IO(fiu) \
+	{RegRepBit((fiu)->SPI_FL_CFG, FIU_SPI_FL_CFG_RD_MODE_Msk, (BIT7 | BIT6));}
+
+/*--------------------------------------*/
+/* BURST_CFG fields (offset 0x01)      */
+/*--------------------------------------*/
+#define FIU_BURST_CFG_R_BURST_Pos	(0)
+#define FIU_BURST_CFG_R_BURST_Msk	(0x3 << FIU_BURST_CFG_R_BURST_Pos)
+
+/*--------------------------------------*/
+/* RESP_CFG fields (offset 0x02)       */
+/*--------------------------------------*/
+#define FIU_RESP_CFG_QUAD_EN_Pos	(3)
