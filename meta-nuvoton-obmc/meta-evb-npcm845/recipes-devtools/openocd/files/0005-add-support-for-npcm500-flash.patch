+
+/*==========================================================================*/
+/* System Configuration Core Registers (SCFG) - NPCM5MNX                   */
+/*                                                                          */
+/* Base address: 0x400C_3000                                                */
+/*==========================================================================*/
+
+typedef struct {
+	volatile uint8_t  DEVCNT;		/*!< [0x00] Device Control              */
+	volatile const uint8_t STRPST1;		/*!< [0x01] Straps Status 1             */
+	volatile uint8_t  RSTCTL;		/*!< [0x02] Reset Control and Status    */
+	volatile uint8_t  DEV_CTL2;		/*!< [0x03] Device Control 2            */
+	volatile uint8_t  DEV_CTL3;		/*!< [0x04] Device Control 3            */
+	volatile uint8_t  Reserved1[1];		/*   [0x05]                             */
+	volatile uint8_t  DEV_CTL4;		/*!< [0x06] Device Control 4            */
+	volatile uint8_t  Reserved2[4];		/*   [0x07-0x0A]                        */
+	volatile uint8_t  DEVALT10;		/*!< [0x0B] Device Alternate Func 10    */
+	volatile uint8_t  DEVALT11;		/*!< [0x0C] Device Alternate Func 11    */
+	volatile uint8_t  Reserved3[3];		/*   [0x0D-0x0F]                        */
+	volatile uint8_t  DEVALT0;		/*!< [0x10] Device Alternate Func 0     */
+	volatile uint8_t  DEVALT1;		/*!< [0x11] Device Alternate Func 1     */
+	volatile uint8_t  DEVALT2;		/*!< [0x12] Device Alternate Func 2     */
+	volatile uint8_t  DEVALT3;		/*!< [0x13] Device Alternate Func 3     */
+	volatile uint8_t  DEVALT4;		/*!< [0x14] Device Alternate Func 4     */
+	volatile uint8_t  DEVALT5;		/*!< [0x15] Device Alternate Func 5     */
+	volatile uint8_t  DEVALT6;		/*!< [0x16] Device Alternate Func 6     */
+	volatile uint8_t  DEVALT7;		/*!< [0x17] Device Alternate Func 7     */
+	volatile uint8_t  DEVALT8;		/*!< [0x18] Device Alternate Func 8     */
+	volatile uint8_t  DEVALT9;		/*!< [0x19] Device Alternate Func 9     */
+	volatile uint8_t  DEVALTA;		/*!< [0x1A] Device Alternate Func A     */
+	volatile uint8_t  DEVALTB;		/*!< [0x1B] Device Alternate Func B     */
+	volatile uint8_t  DEVALTC;		/*!< [0x1C] Device Alternate Func C     */
+	volatile uint8_t  DEVALTD;		/*!< [0x1D] Device Alternate Func D     */
+	volatile uint8_t  DEVALTE;		/*!< [0x1E] Device Alternate Func E     */
+	volatile uint8_t  Reserved4[1];		/*   [0x1F]                             */
+	volatile uint8_t  Reserved5[4];		/*   [0x20-0x23]                        */
+	volatile uint8_t  DEVALTCX;		/*!< [0x24] Device Alternate Func CX    */
+	volatile uint8_t  Reserved6[3];		/*   [0x25-0x27]                        */
+	volatile uint8_t  DEVPU0;		/*!< [0x28] Device Pull-Up Enable 0     */
+	volatile uint8_t  DEVPD1;		/*!< [0x29] Device Pull-Down Enable 1   */
+	volatile uint8_t  LV_CTL0;		/*!< [0x2A] Low-Voltage Control 0       */
+	volatile uint8_t  LV_CTL1;		/*!< [0x2B] Low-Voltage Control 1       */
+	volatile uint8_t  LV_CTL2;		/*!< [0x2C] Low-Voltage Control 2       */
+	volatile uint8_t  LV_CTL3;		/*!< [0x2D] Low-Voltage Control 3       */
+	volatile uint8_t  DEVALT2E;		/*!< [0x2E] Device Alternate Func 2E    */
+	volatile uint8_t  Reserved7[1];		/*   [0x2F]                             */
+	volatile uint8_t  DEVALT30;		/*!< [0x30] Device Alternate Func 30    */
+	volatile uint8_t  DEVALT31;		/*!< [0x31] Device Alternate Func 31    */
+	volatile uint8_t  DEVALT32;		/*!< [0x32] Device Alternate Func 32    */
+	volatile uint8_t  DEVALT33;		/*!< [0x33] Device Alternate Func 33    */
+	volatile uint8_t  Reserved8[1];		/*   [0x34]                             */
+	volatile uint8_t  M4DIS;		/*!< [0x35] Cortex-M4 Function Disable  */
+	volatile uint8_t  Reserved9[22];	/*   [0x36-0x4B]                        */
+	volatile uint8_t  EMCPHY_CTL;		/*!< [0x4C] EMC Mgmt I/F Control        */
+	volatile uint8_t  EMC_CTL;		/*!< [0x4D] EMC Control                 */
+	volatile uint8_t  Reserved10[1];	/*   [0x4E]                             */
+	volatile uint8_t  EMC_INTR_MON;		/*!< [0x4F] EMC Interrupt Monitor       */
+	volatile uint8_t  Reserved11[13];	/*   [0x50-0x5C]                        */
+	volatile uint8_t  DEVALT5D;		/*!< [0x5D] ACPI_GPIO_SEL_1             */
+	volatile uint8_t  Reserved12[1];	/*   [0x5E]                             */
+	volatile uint8_t  DEVALT5F;		/*!< [0x5F] ACPI_GPIO_SEL_3             */
+	volatile uint8_t  Reserved13[2];	/*   [0x60-0x61]                        */
+	volatile uint8_t  DEVALT62;		/*!< [0x62] Device Alternate Func 62    */
+	volatile uint8_t  Reserved14[5];	/*   [0x63-0x67]                        */
+	volatile uint8_t  DEVALT68;		/*!< [0x68] Device Alternate Func 68    */
+	volatile uint8_t  DEVALT69;		/*!< [0x69] Device Alternate Func 69    */
+	volatile uint8_t  Reserved15[3];	/*   [0x6A-0x6C]                        */
+	volatile uint8_t  DEVALT6D;		/*!< [0x6D] Device Alternate Func 6D    */
+	volatile uint8_t  LV_CTL4;		/*!< [0x6E] Low-Voltage Control 4       */
+	volatile uint8_t  Reserved16[4];	/*   [0x6F-0x72]                        */
+	volatile uint8_t  DEVPD2;		/*!< [0x73] Device Pull-Down Enable 2   */
+	volatile uint8_t  Reserved17[2];	/*   [0x74-0x75]                        */
+	volatile uint8_t  DBGFRZEN1;		/*!< [0x76] Debug Freeze Enable 1       */
+	volatile uint8_t  DBGFRZEN2;		/*!< [0x77] Debug Freeze Enable 2       */
+	volatile uint8_t  DBGFRZEN3;		/*!< [0x78] Debug Freeze Enable 3       */
+	volatile uint8_t  DBGFRZEN4;		/*!< [0x79] Debug Freeze Enable 4       */
+	volatile uint8_t  DBGFRZEN5;		/*!< [0x7A] Debug Freeze Enable 5       */
+	volatile uint8_t  DEVPD3;		/*!< [0x7B] Device Pull-Down Enable 3   */
+	volatile uint8_t  DBGFRZEN6;		/*!< [0x7C] Debug Freeze Enable 6       */
+	volatile uint8_t  Reserved18[3];	/*   [0x7D-0x7F]                        */
+	volatile const uint8_t STRPST2;		/*!< [0x80] Straps Status 2 (RO)        */
+	volatile uint8_t  Reserved19[3];	/*   [0x81-0x83]                        */
+	volatile uint32_t RSTST;		/*!< [0x84] Reset Status (Word)         */
+	volatile uint32_t CORST_CTL;		/*!< [0x88] CORST Reset Control (Word)  */
+	volatile uint32_t WDTRST_CTL;		/*!< [0x8C] WDT Reset Control (Word)    */
+	volatile uint32_t IPRST_CTL;		/*!< [0x90] IP SW Reset Control (Word)  */
+	volatile uint8_t  Reserved20[28];	/*   [0x94-0xAF]                        */
+	volatile uint32_t SPAD0;		/*!< [0xB0] Scratchpad 0 (Word)         */
+	volatile uint32_t SPAD1;		/*!< [0xB4] Scratchpad 1 (Word)         */
+	volatile uint32_t SPAD2;		/*!< [0xB8] Scratchpad 2 (Word)         */
+	volatile uint32_t SPAD3;		/*!< [0xBC] Scratchpad 3 (Word)         */
+	volatile uint32_t BUSID_CTL0;		/*!< [0xC0] Bus Master ID Ctrl 0 (Word) */
+	volatile uint32_t BUSID_CTL1;		/*!< [0xC4] Bus Master ID Ctrl 1 (Word) */
+	volatile uint32_t BUSID_CTL2;		/*!< [0xC8] Bus Master ID Ctrl 2 (Word) */
+} SCFG_T;
+
+#define SCFG_BASE_ADDR			(0x400C3000)
+#define SCFG				((SCFG_T *) SCFG_BASE_ADDR)
+
+/*--------------------------------------*/
+/* DEVCNT fields (offset 0x00)         */
+/*--------------------------------------*/
+#define SCFG_DEVCNT_SHD_SPI_TRIS_Pos	(6)
+#define SCFG_DEVCNT_SHD_SPI_TRIS_Msk	(0x1 << SCFG_DEVCNT_SHD_SPI_TRIS_Pos)
+
+/*--------------------------------------*/
+/* DEVALT0 fields (offset 0x10)        */
+/*   Bits[7:3] Reserved                */
+/*   Bit[2]    FIU_PVT_CS_SL          */
+/*   Bits[1:0] Reserved                */
+/*--------------------------------------*/
+#define SCFG_DEVALT0_FIU_PVT_CS_SL_Pos	(2)
+#define SCFG_DEVALT0_FIU_PVT_CS_SL_Msk	(0x1 << SCFG_DEVALT0_FIU_PVT_CS_SL_Pos)
+
+/*--------------------------------------*/
+/* DEVALTC fields (offset 0x1C)        */
+/*--------------------------------------*/
+#define SCFG_DEVALTC_SHD_SPI_Pos	(3)
+#define SCFG_DEVALTC_SHD_SPI_Msk	(0x1 << SCFG_DEVALTC_SHD_SPI_Pos)
+
+#define SCFG_DEVALTC_SHD_SPI_QUAD_Pos	(2)
+#define SCFG_DEVALTC_SHD_SPI_QUAD_Msk	(0x1 << SCFG_DEVALTC_SHD_SPI_QUAD_Pos)
+
+/*--------------------------------------*/
+/* DEV_CTL4 fields (offset 0x06)       */
+/*--------------------------------------*/
+#define SCFG_DEV_CTL4_AMD_EN_Pos	(2)
+#define SCFG_DEV_CTL4_AMD_EN_Msk	(0x1 << SCFG_DEV_CTL4_AMD_EN_Pos)
+
+/*--------------------------------------*/
+/* FIU pin configuration macros        */
+/*--------------------------------------*/
+#define SET_FIU_SHD_TRI_STATE		{ SCFG->DEVCNT  |= SCFG_DEVCNT_SHD_SPI_TRIS_Msk; }
+#define SET_FIU_SHD_ACTIVE		{ SCFG->DEVCNT  &= ~SCFG_DEVCNT_SHD_SPI_TRIS_Msk; }
+
+#define ENABLE_FIU_SHD_QUAD		{ SCFG->DEVALTC |= SCFG_DEVALTC_SHD_SPI_QUAD_Msk; }
+#define DISABLE_FIU_SHD_QUAD		{ SCFG->DEVALTC &= ~SCFG_DEVALTC_SHD_SPI_QUAD_Msk; }
+
+#define ENABLE_FIU_SHD_SPI		{ SCFG->DEVALTC |= SCFG_DEVALTC_SHD_SPI_Msk; }
+#define DISABLE_FIU_SHD_SPI		{ SCFG->DEVALTC &= ~SCFG_DEVALTC_SHD_SPI_Msk; }
+
+#define ENABLE_FIU_PVT_CS		{ SCFG->DEVALT0 |= SCFG_DEVALT0_FIU_PVT_CS_SL_Msk; }
+#define DISABLE_FIU_PVT_CS		{ SCFG->DEVALT0 &= ~SCFG_DEVALT0_FIU_PVT_CS_SL_Msk; }
+
+/* AMD eSPI */
+#define FIU_SWITCH_TO_SHARE		{ SCFG->DEV_CTL4 &= ~SCFG_DEV_CTL4_AMD_EN_Msk; }
+
+/*==========================================================================*/
+/* HIGH-FREQUENCY CLOCK GENERATOR (HFCG) - NPCM5MNX                        */
+/*                                                                          */
+/* Base address: 0x400B_5000                                                */
+/*==========================================================================*/
+
+typedef struct {
+	volatile uint8_t CTRL;			/*!< [0x00] HFCG Control                */
+	volatile uint8_t Reserved1[1];		/*   [0x01]                             */
+	volatile uint8_t ML;			/*!< [0x02] HFCG M Low Byte Value       */
+	volatile uint8_t Reserved2[1];		/*   [0x03]                             */
+	volatile uint8_t MH;			/*!< [0x04] HFCG M High Byte Value      */
+	volatile uint8_t Reserved3[1];		/*   [0x05]                             */
+	volatile uint8_t N;			/*!< [0x06] HFCG N Value                */
+	volatile uint8_t Reserved4[1];		/*   [0x07]                             */
+	volatile uint8_t P;			/*!< [0x08] HFCG Prescaler              */
+	volatile uint8_t Reserved5[7];		/*   [0x09-0x0F]                        */
+	volatile uint8_t BCD;			/*!< [0x10] HFCG Bus Clock Dividers     */
+	volatile uint8_t Reserved6[1];		/*   [0x11]                             */
+	volatile uint8_t BCD1;			/*!< [0x12] HFCG Bus Clock Dividers 1   */
+	volatile uint8_t Reserved7[1];		/*   [0x13]                             */
+	volatile uint8_t BCD2;			/*!< [0x14] HFCG Bus Clock Dividers 2   */
+	volatile uint8_t Reserved8[1];		/*   [0x15]                             */
+	volatile uint8_t BCD3;			/*!< [0x16] HFCG Bus Clock Dividers 3   */
+} HFCG_T;
+
+#define HFCG_BASE_ADDR			(0x400B5000)
+#define HFCG				((HFCG_T *) HFCG_BASE_ADDR)
+
+/*--------------------------------------*/
+/* HFCBCD1 fields (offset 0x12)        */
+/*--------------------------------------*/
+#define HFCG_BCD1_FIUDIV_Pos		(0)
+#define HFCG_BCD1_FIUDIV_Msk		(0x3 << HFCG_BCD1_FIUDIV_Pos)
+
+/* FIU clock divider helper */
+#define SET_FIU_CLK_DIV(div)		{HFCG->BCD1 = ((HFCG->BCD1 & (~HFCG_BCD1_FIUDIV_Msk)) | \
+					(((div) & 0x03) << HFCG_BCD1_FIUDIV_Pos));}
+
+/*==========================================================================*/
+/* NPCM500 Flash AHB Memory Map                                            */
+/*   0xC000_0000 - 0xCFFF_FFFF  External Flash 1 (SHD_CS) 256MB           */
+/*   0xD000_0000 - 0xDFFF_FFFF  External Flash 2 (PVT_CS) 256MB           */
+/*   0xB000_0000 - 0xBFFF_FFFF  Internal MCP Flash        256MB           */
+/*   0x9000_0000 - 0x9FFF_FFFF  HyperRAM                  256MB           */
+/*==========================================================================*/
+#define NPCM500_SHD_FLASH_BASE		0xC0000000U
+#define NPCM500_PVT_FLASH_BASE		0xD0000000U
+#define NPCM500_MCP_FLASH_BASE		0xB0000000U
+#define NPCM500_HYPERRAM_BASE		0x90000000U
+
+/* Flash vendor IDs */
+#define FLASH_ID_WINBOND		0xEF
+#define FLASH_ID_MXIC			0xC2
+#define FLASH_ID_GIGADEV		0xC8
+#define FLASH_ID_CYPRESS		0x01
+#define FLASH_ID_MICRON			0x20
+#define FLASH_ID_UNSUPP			0xFF
+
+/*==========================================================================*/
+/* General DMA (GDMA) Controller                                           */
+/*==========================================================================*/
+#define M8(addr)	(*((volatile unsigned char  *) (addr)))
+#define M16(addr)	(*((volatile unsigned short *) (addr)))
+#define M32(addr)	(*((volatile unsigned long  *) (addr)))
+
+#define GDMA_BASE_ADDR			(0x40011000)
+
+#define GDMA_CTL0			M32(GDMA_BASE_ADDR + 0x00)
+#define GDMA_SRCB0			M32(GDMA_BASE_ADDR + 0x04)
+#define GDMA_DSTB0			M32(GDMA_BASE_ADDR + 0x08)
+#define GDMA_TCNT0			M32(GDMA_BASE_ADDR + 0x0C)
+#define GDMA_CSRC0			M32(GDMA_BASE_ADDR + 0x10)
+#define GDMA_CDST0			M32(GDMA_BASE_ADDR + 0x14)
+#define GDMA_CTCNT0			M32(GDMA_BASE_ADDR + 0x18)
+
+#define GDMA_CTL1			M32(GDMA_BASE_ADDR + 0x20)
+#define GDMA_SRCB1			M32(GDMA_BASE_ADDR + 0x24)
+#define GDMA_DSTB1			M32(GDMA_BASE_ADDR + 0x28)
+#define GDMA_TCNT1			M32(GDMA_BASE_ADDR + 0x2C)
+#define GDMA_CSRC1			M32(GDMA_BASE_ADDR + 0x30)
+#define GDMA_CDST1			M32(GDMA_BASE_ADDR + 0x34)
+#define GDMA_CTCNT1			M32(GDMA_BASE_ADDR + 0x38)
+
+#endif /* OPENOCD_LOADERS_FLASH_NCT_ESIO_NPCM500_FLASH_H */
diff -ruN a/contrib/loaders/flash/nct_esio/npcm500_flash.lds b/contrib/loaders/flash/nct_esio/npcm500_flash.lds
--- a/contrib/loaders/flash/nct_esio/npcm500_flash.lds	2026-04-21 15:24:04.157859837 +0800
+++ b/contrib/loaders/flash/nct_esio/npcm500_flash.lds	2026-04-21 15:24:04.159859839 +0800
@@ -0,0 +1,59 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* NPCM500 (NPCM5MNX) application memory map
+ * RAM: 0x0000_0000 - 0x000F_FFFF (1MB)
+ * Use offset 0x20000 to avoid vector table / boot code area
+ */
+MEMORY {
+        /* buffer + parameters */
+        BUFFER (RWX)  : ORIGIN = 0x00020000,
+                        LENGTH = 0x1000 + 20
+
+        PROGRAM (RWX)  : ORIGIN = 0x00021014,
+                         LENGTH = 0x1000
+}
+
+/* Sections used for flashing */
+SECTIONS
+{
+        .buffers (NOLOAD) :
+        {
+                _buffers = .;
+                *(.buffers.g_cfg)
+                *(.buffers.g_buf)
+                *(.buffers*)
+                _ebuffers = .;
+        } > BUFFER
+
+        .text :
+        {
+                _text = .;
+                *(.entry*)
+                *(.text*)
+                _etext = .;
+        } > PROGRAM
+
+        .data :
+        {       _data = .;
+                *(.rodata*)
+                *(.data*)
+                _edata = .;
+        } > PROGRAM
+
+        .bss :
+        {
+                __bss_start__ = .;
+                _bss = .;
+                *(.bss*)
+                *(COMMON)
+                _ebss = .;
+                __bss_end__ = .;
+        } > PROGRAM
+
+        .stack (NOLOAD) :
+        {
+                _stack = .;
+                *(.stack*)
+                _estack = .;
+        } > PROGRAM
+}
