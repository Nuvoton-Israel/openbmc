+
+#define FIU_SET_CMD_EN_SHD_Pos		(5)
+#define FIU_SET_CMD_EN_SHD_Msk		(0x1 << FIU_SET_CMD_EN_SHD_Pos)
+
+#define FIU_SET_CMD_EN_PVT_Pos		(4)
+#define FIU_SET_CMD_EN_PVT_Msk		(0x1 << FIU_SET_CMD_EN_PVT_Pos)
+
+/*--------------------------------------*/
+/* _4B_EN register (offset 0x3D)       */
+/*--------------------------------------*/
+#define FIU_4B_EN_BACK_Pos		(6)
+#define FIU_4B_EN_BACK_Msk		(0x1 << FIU_4B_EN_BACK_Pos)
+
+#define FIU_4B_EN_SHD_Pos		(5)
+#define FIU_4B_EN_SHD_Msk		(0x1 << FIU_4B_EN_SHD_Pos)
+
+#define FIU_4B_EN_PVT_Pos		(4)
