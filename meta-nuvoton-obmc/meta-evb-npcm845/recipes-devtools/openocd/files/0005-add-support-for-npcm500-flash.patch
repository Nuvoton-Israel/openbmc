--- a/tcl/board/npcm500_evb.cfg	2026-04-21 15:24:04.196859868 +0800
+++ b/tcl/board/npcm500_evb.cfg	2026-04-21 15:24:04.197859869 +0800
@@ -0,0 +1,33 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# NPCM500 (NPCM5MNX) EVB - accessed from Arbel NPCM845 JTAG Master
+#
+# Usage from Arbel BMC console:
+#   gpioset 2 6=0
+#   openocd -f /usr/share/openocd/scripts/npcm500_evb.cfg
+#
+# Wiring: Arbel J_JTAGM header → NPCM500 JTAG header
+#   Pin 4 (TCK), Pin 2 (TMS), Pin 8 (TDI), Pin 6 (TDO), Pin 3 (GND)
+
+adapter driver npcm_jtag
+transport select jtag
+adapter speed 1000
+npcm_jtag_device jtag0
+
+set _CHIPNAME NPCM500
+jtag newtap $_CHIPNAME cpu -irlen 4 -expected-id 0x2BA01477
+dap create $_CHIPNAME.dap -chain-position $_CHIPNAME.cpu
+target create $_CHIPNAME.cpu cortex_m -dap $_CHIPNAME.dap
+
+set _TARGETNAME $_CHIPNAME.cpu
+$_TARGETNAME configure -work-area-phys 0x200C0000 -work-area-size 0x8000 -work-area-backup 0
+
+reset_config none
+cortex_m reset_config vectreset
+gdb_breakpoint_override hard
+
+# Flash configuration: MCP internal flash on FIU2 at 0xB0000000
+set _FLASHNAME $_CHIPNAME.mcp.flash
+flash bank $_FLASHNAME nct_esio 0xB0000000 0 0 0 $_TARGETNAME $_CHIPNAME
+
+init

