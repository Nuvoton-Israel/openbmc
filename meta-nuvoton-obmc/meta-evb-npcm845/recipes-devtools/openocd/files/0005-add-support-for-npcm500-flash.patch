+// SPDX-License-Identifier: GPL-2.0-or-later
+
+#include <stdint.h>
+#include <string.h>
+#include "npcm500_flash.h"
+
+/* flashloader parameter structure */
+__attribute__ ((section(".buffers.g_cfg")))
+static volatile struct nct_esio_flash_params g_cfg;
+
+/* data buffer */
+__attribute__ ((section(".buffers.g_buf")))
+static volatile uint8_t g_buf[0x1000];
+
+static inline uint32_t __REV(uint32_t value) {
+	return ((value & 0xFF000000) >> 24) |
+	       ((value & 0x00FF0000) >> 8)  |
+	       ((value & 0x0000FF00) << 8)  |
+	       ((value & 0x000000FF) << 24);
+}
+
+static void delay(uint32_t i)
+{
+	while (i--)
+		__asm__ volatile ("nop");
+}
+
+/*
+ * Get the FIU pointer for a given flash port.
+ *   SHD and BAK use FIU0 (base 0x40020000)
+ *   MCP uses FIU2 (base 0x40023000)
+ */
+static FIU_T *port_to_fiu(enum flash_port port)
+{
+	if (port == FLASH_PORT_MCP)
+		return FIU2;
+	return FIU0;
+}
+
+/*
+ * Get DEV_NUM value for UMA_CTS based on port.
+ *   SHD  → DEV_NUM=1 (selects CS1 on FIU0)
+ *   BAK  → DEV_NUM=0 (BACK_CS selected via DEV_NUM_BACK in UMA_ECTS)
+ *   MCP  → DEV_NUM=0 (selects CS0 on FIU2)
+ */
+static uint8_t port_dev_num(enum flash_port port)
+{
+	if (port == FLASH_PORT_SHD)
+		return FIU_UMA_CTS_DEV_NUM_Msk;  /* DEV_NUM=1 */
+	return 0;  /* DEV_NUM=0 for BAK and MCP */
+}
+
+/*
+ * Get chip-select keep-low mask for UMA_ECTS manual mode.
+ * The bits set HIGH in UMA_ECTS will keep the corresponding CS deasserted.
+ * We set all CS HIGH except the one we want to keep low.
+ * For BAK port, also set DEV_NUM_BACK to route UMA to BACK_CS.
+ */
+static uint8_t port_cs_low(enum flash_port port)
+{
+	switch (port) {
+	case FLASH_PORT_SHD:
+		/* FIU0: keep CS0+CS2 high, CS1 driven by UMA engine */
+		return FIU_UMA_ECTS_SW_CS0_Msk | FIU_UMA_ECTS_SW_CS2_Msk;
+	case FLASH_PORT_BAK:
+		/* FIU0: DEV_NUM_BACK=1 to select BACK_CS, keep CS0+CS1 high */
+		return FIU_UMA_ECTS_DEV_NUM_BACK_Msk |
+		       FIU_UMA_ECTS_SW_CS0_Msk | FIU_UMA_ECTS_SW_CS1_Msk;
+	case FLASH_PORT_MCP:
+		/* FIU2: only CS0 and CS1; keep CS1 high */
+		return FIU_UMA_ECTS_SW_CS1_Msk;
+	default:
+		return FIU_UMA_ECTS_CS_ALL_HIGH;
+	}
+}
+
+/*
+ * Get chip-select all-high (deselect) mask for the FIU used by this port.
+ * For BAK port, DEV_NUM_BACK must remain set so UMA engine targets BACK_CS.
+ */
+static uint8_t port_cs_all_high(enum flash_port port)
+{
+	if (port == FLASH_PORT_BAK)
+		return FIU_UMA_ECTS_DEV_NUM_BACK_Msk | FIU_UMA_ECTS_CS_ALL_HIGH;
+	if (port == FLASH_PORT_MCP)
+		return FIU_UMA_ECTS_SW_CS0_Msk | FIU_UMA_ECTS_SW_CS1_Msk;
+	return FIU_UMA_ECTS_CS_ALL_HIGH;
+}
+
+static void UMA_ExeCmd(FIU_T *fiu, enum flash_command cmd, uint8_t sts)
+{
+	fiu->UMA_CODE = cmd;
+	fiu->UMA_CTS = sts;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+}
+
+static int UMA_WaitFlashReady(FIU_T *fiu, uint8_t flash_sel, uint32_t timeout_ms)
+{
+	uint32_t countdownTick = timeout_ms * 20;
+
+	while (1) {
+		delay(2399);
+		UMA_ExeCmd(fiu, FLASH_CMD_READ_STATUS_REG,
+			   FIU_UMA_CTS_EXEC_DONE_Msk | flash_sel | 1);
+		if ((fiu->UMA_DB0 & 0x01) == 0)
+			break;
+		if (countdownTick == 0)
+			continue;
+		if (--countdownTick == 0)
+			return -1;
+	}
+
+	return 0;
+}
+
+static void gdma_memcpy_u8(uint8_t *dst, uint8_t *src, uint32_t cpylen)
+{
+	if (cpylen == 0)
+		return;
+
+	GDMA_SRCB0 = (uint32_t)src;
+	GDMA_DSTB0 = (uint32_t)dst;
+	GDMA_TCNT0 = cpylen;
+	GDMA_CTL0  = 0x10001;
+
+	while (GDMA_CTL0 & 0x1);
+	GDMA_CTL0 = 0;
+}
+
+static void gdma_memcpy_burst_u32(uint8_t *dst, uint8_t *src, uint32_t cpylen)
+{
+	uint32_t rlen;
+	FIU_T *fiu = FIU0;
+
+	if (cpylen == 0)
+		return;
+
+	if (((uint32_t)src & 0x0F) || ((uint32_t)dst & 0xF)) {
+		gdma_memcpy_u8(dst, src, cpylen);
+		return;
+	}
+
+	rlen = cpylen & 0xFFFFFFC0;
+	if (rlen) {
+		fiu->BURST_CFG = 0x0B;
+
+		GDMA_SRCB0 = (uint32_t)src;
+		GDMA_DSTB0 = (uint32_t)dst;
+		GDMA_TCNT0 = rlen / 16;
+		GDMA_CTL0  = 0x12201;
+
+		while (GDMA_CTL0 & 0x1);
+		GDMA_CTL0 = 0;
+		fiu->BURST_CFG = 0x03;
+
+		src += rlen;
+		dst += rlen;
+		cpylen -= rlen;
+	}
+
+	if (cpylen)
+		gdma_memcpy_u8(dst, src, cpylen);
+}
+
+/*
+ * Read flash via Direct Memory Mapping (DMM) path.
+ * SHD flash → 0xC0000000, BAK flash → 0xD0000000, MCP → 0xB0000000
+ */
+static int fiu_read_dmm(enum flash_port port, uint32_t addr,
+			 uint8_t *buff, uint32_t len, uint8_t adr_4b)
+{
+	FIU_T *fiu = port_to_fiu(port);
+	uint32_t flash_base;
+
+	switch (port) {
+	case FLASH_PORT_SHD:
+		flash_base = NPCM500_SHD_FLASH_BASE;
+		if (adr_4b) {
+			fiu->FIU_EXT_CFG |= FIU_EXT_CFG_FOUR_BADDR_Msk;
+			fiu->SET_CMD_EN |= FIU_SET_CMD_EN_SHD_Msk;
+			fiu->RD_CMD_SHD = FLASH_CMD_4BYTE_DUAL_IO_READ;
+		}
+		gdma_memcpy_burst_u32(buff, (uint8_t *)(addr + flash_base), len);
+		if (adr_4b) {
+			fiu->SET_CMD_EN &= ~FIU_SET_CMD_EN_SHD_Msk;
+			fiu->FIU_EXT_CFG &= ~FIU_EXT_CFG_FOUR_BADDR_Msk;
+			fiu->RD_CMD_SHD = 0;
+		}
+		break;
+
+	case FLASH_PORT_BAK:
+		flash_base = NPCM500_PVT_FLASH_BASE;
+		/* BAK uses FIU0 SW_CS2 = PVT_CS in AHB map */
+		gdma_memcpy_burst_u32(buff, (uint8_t *)(addr + flash_base), len);
+		break;
+
+	case FLASH_PORT_MCP:
+		flash_base = NPCM500_MCP_FLASH_BASE;
+		/* MCP uses FIU2, DMM read */
+		gdma_memcpy_burst_u32(buff, (uint8_t *)(addr + flash_base), len);
+		break;
+
+	default:
+		return -1;
+	}
+
+	return 0;
+}
+
+/*
+ * Page Program via UMA.
+ * For all ports we use FIU UMA with appropriate CS and DEV_NUM settings.
+ */
+static int FIU_PageProgram(enum flash_port port, uint32_t addr,
+			   uint8_t *data, uint32_t len, uint8_t FourByteMode)
+{
+	FIU_T *fiu = port_to_fiu(port);
+	uint8_t dev_num = port_dev_num(port);
+	uint8_t cs_low  = port_cs_low(port);
+	uint8_t cs_high = port_cs_all_high(port);
+	uint16_t dataCnt;
+	uint16_t maxBytes = 256 - (addr % 256);
+	uint16_t n;
+	uint32_t d_size;
+	int ret = 0;
+
+	if (FourByteMode)
+		fiu->FIU_EXT_CFG |= FIU_EXT_CFG_FOUR_BADDR_Msk;
+
+	FIU_UMA_BLOCK(fiu);
+
+	while (len > 0) {
+		n = (len <= maxBytes) ? len : maxBytes;
+
+		/* Write Enable */
+		fiu->UMA_ECTS = cs_high;
+		UMA_ExeCmd(fiu, FLASH_CMD_WRITE_ENABLE,
+			   FIU_UMA_CTS_EXEC_DONE_Msk | dev_num);
+
+		/* Begin page program: keep CS low */
+		if (!FourByteMode)
+			fiu->FIU_EXT_CFG &= ~FIU_EXT_CFG_FOUR_BADDR_Msk;
+
+		fiu->UMA_ECTS = cs_low;
+		fiu->UMA_AB0_3 = addr;
+		fiu->UMA_CODE  = FourByteMode ? FLASH_CMD_4BYTE_PROGRAM :
+						 FLASH_CMD_PAGE_PROGRAM;
+		fiu->UMA_CTS   = FIU_UMA_CTS_EXEC_DONE_Msk |
+				  FIU_UMA_CTS_RD_WR_Msk |
+				  FIU_UMA_CTS_A_SIZE_Msk |
+				  dev_num | 0;
+		while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+		fiu->FIU_EXT_CFG |= FIU_EXT_CFG_FOUR_BADDR_Msk;
+
+		/* Stream data in 9-byte or 5-byte bursts */
+		dataCnt = 0;
+		while (dataCnt < n) {
+			if ((n - dataCnt) >= 9)
+				d_size = 9;
+			else if ((n - dataCnt) < 5)
+				d_size = (n - dataCnt);
+			else
+				d_size = 5;
+
+			while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+			if (d_size == 9) {
+				fiu->UMA_CODE  = data[0];
+				fiu->UMA_AB0_3 = __REV(*(uint32_t *)&data[1]);
+				fiu->UMA_DB0   = data[5];
+				fiu->UMA_DB1   = data[6];
+				fiu->UMA_DB2   = data[7];
+				fiu->UMA_DB3   = data[8];
+				fiu->UMA_CTS   = FIU_UMA_CTS_EXEC_DONE_Msk |
+						  FIU_UMA_CTS_RD_WR_Msk |
+						  FIU_UMA_CTS_A_SIZE_Msk |
+						  dev_num | 4;
+			} else {
+				fiu->UMA_CODE = data[0];
+				fiu->UMA_DB0  = data[1];
+				fiu->UMA_DB1  = data[2];
+				fiu->UMA_DB2  = data[3];
+				fiu->UMA_DB3  = data[4];
+				fiu->UMA_CTS  = FIU_UMA_CTS_EXEC_DONE_Msk |
+						 FIU_UMA_CTS_RD_WR_Msk |
+						 dev_num | (d_size - 1);
+			}
+
+			data    += d_size;
+			dataCnt += d_size;
+		}
+
+		while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+		fiu->UMA_ECTS = cs_high;  /* Release CS */
+
+		if ((ret = UMA_WaitFlashReady(fiu, dev_num, 50)) < 0)
+			break;
+
+		addr    += n;
+		len     -= n;
+		maxBytes = 256;
+	}
+
+	FIU_UMA_UNBLOCK(fiu);
+	fiu->FIU_EXT_CFG &= ~FIU_EXT_CFG_FOUR_BADDR_Msk;
+
+	return ret;
+}
+
+/*
+ * Sector Erase via UMA.
+ */
+static int FIU_SectorErase(enum flash_port port, uint32_t addr,
+			    uint8_t FourByteMode)
+{
+	FIU_T *fiu = port_to_fiu(port);
+	uint8_t dev_num = port_dev_num(port);
+	uint8_t cs_high = port_cs_all_high(port);
+	int ret;
+
+	if (FourByteMode)
+		fiu->FIU_EXT_CFG |= FIU_EXT_CFG_FOUR_BADDR_Msk;
+
+	FIU_UMA_BLOCK(fiu);
+
+	/* Set UMA_ECTS before first UMA cmd (needed for BAK DEV_NUM_BACK) */
+	fiu->UMA_ECTS = cs_high;
+
+	/* Write Enable */
+	UMA_ExeCmd(fiu, FLASH_CMD_WRITE_ENABLE,
+		   FIU_UMA_CTS_EXEC_DONE_Msk | dev_num);
+
+	/* Set address and erase */
+	fiu->UMA_AB0_3 = addr;
+	UMA_ExeCmd(fiu, FourByteMode ? FLASH_CMD_4BYTE_SECTOR_ERASE :
+					FLASH_CMD_SECTOR_ERASE,
+		   FIU_UMA_CTS_EXEC_DONE_Msk | FIU_UMA_CTS_A_SIZE_Msk | dev_num);
+
+	/* Wait for erase to complete */
+	ret = UMA_WaitFlashReady(fiu, dev_num, 500);
+
+	FIU_UMA_UNBLOCK(fiu);
+
+	if (FourByteMode)
+		fiu->FIU_EXT_CFG &= ~FIU_EXT_CFG_FOUR_BADDR_Msk;
+
+	return ret;
+}
+
+/*
+ * Read JEDEC ID via UMA.
+ */
+static uint32_t FIU_GetID(enum flash_port port)
+{
+	FIU_T *fiu = port_to_fiu(port);
+	uint8_t dev_num = port_dev_num(port);
+	uint8_t cs_high = port_cs_all_high(port);
+
+	FIU_UMA_BLOCK(fiu);
+
+	fiu->UMA_ECTS = cs_high;
+	fiu->UMA_CODE = FLASH_CMD_READ_JEDEC_ID;
+	fiu->UMA_DB0  = 0;
+	fiu->UMA_DB1  = 0;
+	fiu->UMA_DB2  = 0;
+
+	fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | dev_num | 3;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+	fiu->UMA_ECTS = cs_high;
+	FIU_UMA_UNBLOCK(fiu);
+
+	return ((fiu->UMA_DB0 << 16) | (fiu->UMA_DB1 << 8) | fiu->UMA_DB2);
+}
+
+/*
+ * Get flash info via SFDP (Serial Flash Discoverable Parameters).
+ * Returns JEDEC ID in buf[0..2], flash size in buf[4..7], 4B flag in buf[8].
+ */
+static uint8_t fiu_get_flash_info(enum flash_port port, uint8_t *buf)
+{
+	FIU_T *fiu = port_to_fiu(port);
+	uint8_t dev_num = port_dev_num(port);
+	uint8_t cs_high = port_cs_all_high(port);
+	uint32_t flash_size;
+	uint8_t sfdp_hdr[16];
+	uint8_t sfdp_param[8];
+	int i;
+
+	FIU_UMA_BLOCK(fiu);
+	fiu->UMA_ECTS = cs_high;
+
+	/* Read JEDEC ID */
+	fiu->UMA_CODE = FLASH_CMD_READ_JEDEC_ID;
+	fiu->UMA_DB0 = 0;
+	fiu->UMA_DB1 = 0;
+	fiu->UMA_DB2 = 0;
+	fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | dev_num | 3;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+	buf[0] = fiu->UMA_DB2;  /* Manufacturer ID */
+	buf[1] = fiu->UMA_DB1;  /* Memory Type */
+	buf[2] = fiu->UMA_DB0;  /* Capacity */
+
+	/* Read SFDP header: cmd=0x5A, 3-byte addr=0, 1 dummy byte, then 16 data */
+	/* We use manual CS mode for this multi-phase transaction */
+	fiu->UMA_ECTS = port_cs_low(port);
+	fiu->FIU_MSR_IE_CFG |= FIU_MSR_IE_CFG_UMA_BLOCK_Msk;
+
+	/* Send command 0x5A + 3 addr bytes (0x000000) */
+	fiu->UMA_CODE = 0x5A;
+	fiu->UMA_AB0 = 0;
+	fiu->UMA_AB1 = 0;
+	fiu->UMA_AB2 = 0;
+	fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | dev_num | FIU_UMA_CTS_A_SIZE_Msk;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+	/* Dummy byte */
+	fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | FIU_UMA_CTS_C_SIZE_Msk | dev_num | 1;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+	/* Read 16 bytes (4 at a time) */
+	for (i = 0; i < 16; i += 4) {
+		fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | FIU_UMA_CTS_C_SIZE_Msk | dev_num | 4;
+		while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+		sfdp_hdr[i]     = fiu->UMA_DB0;
+		sfdp_hdr[i + 1] = fiu->UMA_DB1;
+		sfdp_hdr[i + 2] = fiu->UMA_DB2;
+		sfdp_hdr[i + 3] = fiu->UMA_DB3;
+	}
+
+	fiu->UMA_ECTS = cs_high;
+	fiu->FIU_MSR_IE_CFG &= ~FIU_MSR_IE_CFG_UMA_BLOCK_Msk;
+
+	/* Validate SFDP signature */
+	if (!(sfdp_hdr[0] == 'S' && sfdp_hdr[1] == 'F' &&
+	      sfdp_hdr[2] == 'D' && sfdp_hdr[3] == 'P')) {
+		FIU_UMA_UNBLOCK(fiu);
+		return 0xFF;
+	}
+
+	/* Read SFDP Basic Flash Parameters table */
+	fiu->UMA_ECTS = port_cs_low(port);
+	fiu->FIU_MSR_IE_CFG |= FIU_MSR_IE_CFG_UMA_BLOCK_Msk;
+
+	fiu->UMA_CODE = 0x5A;
+	fiu->UMA_AB2 = sfdp_hdr[0x0E];
+	fiu->UMA_AB1 = sfdp_hdr[0x0D];
+	fiu->UMA_AB0 = sfdp_hdr[0x0C];
+	fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | dev_num | FIU_UMA_CTS_A_SIZE_Msk;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+	/* Dummy byte */
+	fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | FIU_UMA_CTS_C_SIZE_Msk | dev_num | 1;
+	while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+
+	/* Read 8 bytes */
+	for (i = 0; i < 8; i += 4) {
+		fiu->UMA_CTS = FIU_UMA_CTS_EXEC_DONE_Msk | FIU_UMA_CTS_C_SIZE_Msk | dev_num | 4;
+		while (fiu->UMA_CTS & FIU_UMA_CTS_EXEC_DONE_Msk);
+		sfdp_param[i]     = fiu->UMA_DB0;
+		sfdp_param[i + 1] = fiu->UMA_DB1;
+		sfdp_param[i + 2] = fiu->UMA_DB2;
+		sfdp_param[i + 3] = fiu->UMA_DB3;
+	}
+
+	fiu->UMA_ECTS = cs_high;
+	fiu->FIU_MSR_IE_CFG &= ~FIU_MSR_IE_CFG_UMA_BLOCK_Msk;
+
+	/* Compute flash size from SFDP density field */
+	if (sfdp_param[7] & 0x80) {
+		FIU_UMA_UNBLOCK(fiu);
+		return 0xFF;
+	}
+
+	flash_size = ((sfdp_param[4] | (sfdp_param[5] << 8) |
+		       (sfdp_param[6] << 16) | (sfdp_param[7] << 24)) + 1) >> 3;
+
+	buf[4] = flash_size & 0xFF;
+	buf[5] = (flash_size >> 8) & 0xFF;
+	buf[6] = (flash_size >> 16) & 0xFF;
+	buf[7] = (flash_size >> 24) & 0xFF;
+
+	/* 4-byte addressing support */
+	buf[8] = (sfdp_param[2] & 0x03) ? 1 : 0;
+
+	FIU_UMA_UNBLOCK(fiu);
+	return 0;
+}
+
+/*
+ * Pin/FIU mux selection for the flash port.
+ * Configures SCFG registers to route the correct FIU to the flash.
+ */
+static void PinSelect(enum flash_port port)
+{
+	switch (port) {
+	case FLASH_PORT_SHD:
+		/* FIU0 SHD: standard SPI routing */
+		SCFG->DEVCNT = 0x00;
+		SCFG->DEVALTC = 0x28;
+		break;
+	case FLASH_PORT_BAK:
+		/* FIU0 PVT/BAK: alternate routing */
+		SCFG->DEVCNT = 0x40;
+		SCFG->DEVALTC = 0x10;
+		break;
+	case FLASH_PORT_MCP:
+		/* FIU2 MCP: internal flash, no external pin mux needed */
+		break;
+	default:
+		break;
+	}
+}
+
+static void FIU_4ByteMode(enum flash_port port, uint8_t enter)
+{
+	FIU_T *fiu = port_to_fiu(port);
+	uint8_t dev_num = port_dev_num(port);
+	uint8_t cs_high = port_cs_all_high(port);
+	uint8_t four_b_mask;
+
+	FIU_UMA_BLOCK(fiu);
+
+	/* Set UMA_ECTS before UMA cmd (needed for BAK DEV_NUM_BACK) */
+	fiu->UMA_ECTS = cs_high;
+
+	if (enter) {
+		UMA_ExeCmd(fiu, FLASH_CMD_ENTER_4BYTE_MODE,
+			   FIU_UMA_CTS_EXEC_DONE_Msk | dev_num);
+	} else {
+		UMA_ExeCmd(fiu, FLASH_CMD_EXIT_4BYTE_MODE,
+			   FIU_UMA_CTS_EXEC_DONE_Msk | dev_num);
+	}
+
+	FIU_UMA_UNBLOCK(fiu);
+
+	/* Set per-CS 4-byte mode in _4B_EN register (offset 0x3D) */
+	switch (port) {
+	case FLASH_PORT_SHD:
+		four_b_mask = FIU_4B_EN_SHD_Msk;
+		break;
+	case FLASH_PORT_BAK:
+		four_b_mask = FIU_4B_EN_BACK_Msk;
+		break;
+	case FLASH_PORT_MCP:
+		four_b_mask = FIU_4B_EN_PVT_Msk;
+		break;
+	default:
+		return;
+	}
+
+	if (enter)
+		fiu->_4B_EN |= four_b_mask;
+	else
+		fiu->_4B_EN &= ~four_b_mask;
+}
+
+static void fiu_port_init(enum flash_port port, uint8_t adr_4b)
+{
+	FIU_T *fiu = port_to_fiu(port);
+
+	PinSelect(port);
+	fiu->BURST_CFG = 3;
+
+	if (port == FLASH_PORT_SHD)
+		FIU_RD_MODE_FAST_RD_DUAL_IO(fiu);
+
+	FIU_4ByteMode(port, adr_4b);
+}
+
+static void flashloader_init(void)
+{
+	memset((struct nct_esio_flash_params *)&g_cfg, 0,
+	       sizeof(struct nct_esio_flash_params));
+	memset((uint8_t *)g_buf, 0, sizeof(g_buf));
+	g_cfg.state = FLASH_ALGO_STATE_IDLE;
+}
+
+int main(void)
+{
+	uint8_t status;
+	uint32_t id;
+
+	flashloader_init();
+
+	while (1) {
+		enum flash_port port;
+
+		while (g_cfg.state == FLASH_ALGO_STATE_IDLE);
+
+		port = g_cfg.type;
+
+		/* Validate port */
+		if (port != FLASH_PORT_SHD &&
+		    port != FLASH_PORT_BAK &&
+		    port != FLASH_PORT_MCP) {
+			g_cfg.state = 0xFF;
+			while (1);
+		}
+
+		switch (g_cfg.cmd) {
+		case FLASH_ALGO_CMD_INIT:
+			PinSelect(port);
+			if (port == FLASH_PORT_MCP || port == FLASH_PORT_BAK) {
+				/* For MCP (FIU2) and BAK, just read JEDEC ID */
+				id = FIU_GetID(port);
+				if (id == 0 || id == 0xFFFFFF) {
+					status = 0xFF;
+				} else {
+					g_buf[0] = id & 0xFF;
+					g_buf[1] = (id >> 8) & 0xFF;
+					g_buf[2] = (id >> 16) & 0xFF;
+					g_buf[3] = 0x00;
+					g_buf[8] = 0;  /* Assume 3-byte addr by default */
+					status = 0;
+				}
+			} else {
+				/* SHD: full SFDP-based discovery */
+				status = fiu_get_flash_info(port, (uint8_t *)g_buf);
+			}
+			break;
+
+		case FLASH_ALGO_CMD_ERASE:
+			fiu_port_init(port, g_cfg.adr_4b);
+			status = FIU_SectorErase(port, g_cfg.addr, g_cfg.adr_4b);
+			break;
+
+		case FLASH_ALGO_CMD_PROGRAM:
+			fiu_port_init(port, g_cfg.adr_4b);
+			status = FIU_PageProgram(port, g_cfg.addr,
+						 (uint8_t *)g_buf, g_cfg.len,
+						 g_cfg.adr_4b);
+			break;
+
+		case FLASH_ALGO_CMD_READ:
+			fiu_port_init(port, g_cfg.adr_4b);
+			status = fiu_read_dmm(port, g_cfg.addr,
+					      (uint8_t *)g_buf, g_cfg.len,
+					      g_cfg.adr_4b);
+			break;
+
+		default:
+			status = 0xFF;
+			break;
+		}
+
+		if (status != 0) {
+			g_cfg.state = status;
+			while (1);
+		} else {
+			g_cfg.state = FLASH_ALGO_STATE_IDLE;
+		}
+	}
+
+	return 0;
+}
+
+__attribute__ ((section(".stack")))
+__attribute__ ((used))
+static uint32_t stack[400 / 4];
+
+extern uint32_t _estack;
+extern uint32_t _bss;
+extern uint32_t _ebss;
+
+__attribute__ ((section(".entry")))
+void entry(void)
+{
+	__asm(" ldr sp, =_estack - 4");
+	main();
+	__asm(" bkpt #0x00");
+}
diff -ruN a/contrib/loaders/flash/nct_esio/npcm500_flash.h b/contrib/loaders/flash/nct_esio/npcm500_flash.h
--- a/contrib/loaders/flash/nct_esio/npcm500_flash.h	2026-04-21 15:24:04.176859852 +0800
+++ b/contrib/loaders/flash/nct_esio/npcm500_flash.h	2026-04-21 15:24:04.177859853 +0800
@@ -0,0 +1,522 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+
+#ifndef OPENOCD_LOADERS_FLASH_NCT_ESIO_NPCM500_FLASH_H
+#define OPENOCD_LOADERS_FLASH_NCT_ESIO_NPCM500_FLASH_H
+
+/* Define one bit mask */
+#define BIT0	(0x00000001)
+#define BIT1	(0x00000002)
+#define BIT2	(0x00000004)
+#define BIT3	(0x00000008)
+#define BIT4	(0x00000010)
+#define BIT5	(0x00000020)
+#define BIT6	(0x00000040)
+#define BIT7	(0x00000080)
+#define BIT8	(0x00000100)
+#define BIT9	(0x00000200)
+#define BIT10	(0x00000400)
+#define BIT11	(0x00000800)
+#define BIT12	(0x00001000)
+#define BIT13	(0x00002000)
+#define BIT14	(0x00004000)
+#define BIT15	(0x00008000)
+#define BIT16	(0x00010000)
+#define BIT17	(0x00020000)
+#define BIT18	(0x00040000)
+#define BIT19	(0x00080000)
+#define BIT20	(0x00100000)
+#define BIT21	(0x00200000)
+#define BIT22	(0x00400000)
+#define BIT23	(0x00800000)
+#define BIT24	(0x01000000)
+#define BIT25	(0x02000000)
+#define BIT26	(0x04000000)
+#define BIT27	(0x08000000)
+#define BIT28	(0x10000000)
+#define BIT29	(0x20000000)
+#define BIT30	(0x40000000)
+#define BIT31	(0x80000000)
+
+#define RegSetBit(Reg, BitMsk)			{(Reg) |= (BitMsk);}
+#define RegClrBit(Reg, BitMsk)			{(Reg) &= ~(BitMsk);}
+#define RegRepBit(Reg, BitMsk, BitMskVal)	{(Reg) = ((Reg) & ~(BitMsk)) | (BitMskVal);}
+
+enum flash_algo_command {
+	FLASH_ALGO_CMD_INIT = 0,
+	FLASH_ALGO_CMD_ERASE,
+	FLASH_ALGO_CMD_PROGRAM,
+	FLASH_ALGO_CMD_READ,
+	FLASH_ALGO_CMD_VERIFY,
+};
+
+enum flash_algo_state {
+	FLASH_ALGO_STATE_IDLE = 0,
+	FLASH_ALGO_STATE_BUSY,
+};
+
+/*
+ * NPCM500 physical-to-register-role mapping:
+ *
+ *   FIU0 SHD flash (SW_CS1) -> SHD role  (RD_CMD_SHD,  SHD_CMD_EN,  SHD_4B,  DEV_NUM=1)
+ *   FIU0 PVT flash (SW_CS2) -> BAK role  (RD_CMD_BACK, BACK_CMD_EN, BACK_4B, DEV_NUM_BACK=1)
+ *   FIU1 HyperRAM  (SW_CS1) -> SHD role  (RD_CMD_SHD,  SHD_CMD_EN,  SHD_4B,  DEV_NUM=1)
+ *   FIU2 MCP flash (SW_CS0) -> PVT role  (RD_CMD_PVT,  PVT_CMD_EN,  PVT_4B,  DEV_NUM=0)
+ */
+enum flash_port {
+	FLASH_PORT_SHD = 0,		/* FIU0 SW_CS1 - SHD flash (external shared)  */
+	FLASH_PORT_BAK,			/* FIU0 SW_CS2 - PVT flash (external backup)  */
+	FLASH_PORT_MCP,			/* FIU2 SW_CS0 - MCP flash (internal)         */
+	FLASH_PORT_INTERNAL = 0xFF,
+};
+
+enum flash_mode {
+	FLASH_MODE_SINGLE,
+	FLASH_MODE_DUAL,
+	FLASH_MODE_QUAD,
+};
+
+enum flash_command {
+	FLASH_CMD_WRITE_STATUS_REG	= 0x01,
+	FLASH_CMD_PAGE_PROGRAM		= 0x02,
+	FLASH_CMD_READ_DATA		= 0x03,
+	FLASH_CMD_WRITE_DISABLE		= 0x04,
+	FLASH_CMD_READ_STATUS_REG	= 0x05,
+	FLASH_CMD_WRITE_ENABLE		= 0x06,
+	FLASH_CMD_4BYTE_PROGRAM		= 0x12,
+	FLASH_CMD_4BYTE_READ		= 0x13,
+	FLASH_CMD_SECTOR_ERASE		= 0x20,
+	FLASH_CMD_4BYTE_SECTOR_ERASE	= 0x21,
+	FLASH_CMD_READ_STATUS2_REG	= 0x35,
+	FLASH_CMD_ENTER_4BYTE_MODE	= 0xB7,
+	FLASH_CMD_4BYTE_DUAL_IO_READ	= 0xBC,
+	FLASH_CMD_EXIT_4BYTE_MODE	= 0xE9,
+	FLASH_CMD_READ_JEDEC_ID		= 0x9F,
+};
+
+/* Flash loader parameters - must match nct_esio_flash_algo_params in nct_esio.h */
+struct __attribute__((__packed__)) nct_esio_flash_params {
+	volatile uint8_t  state;	/* Flash loader state      */
+	volatile uint8_t  cmd;		/* Flash loader command    */
+	volatile uint8_t  type;		/* Flash type (flash_port) */
+	volatile uint8_t  adr_4b;	/* 4-byte address mode     */
+	volatile uint32_t version;	/* Flash loader version    */
+	volatile uint32_t addr;		/* Address in flash        */
+	volatile uint32_t len;		/* Number of bytes         */
+	volatile uint32_t reserved;	/* Reserved                */
+};
+
+/*==========================================================================*/
+/* FLASH INTERFACE UNIT (FIU) - NPCM5MNX Series                            */
+/*                                                                          */
+/* Core Register Map for FIU:                                               */
+/*   Base: 0x4002_0000 for FIU0 (Slave/Core)                               */
+/*         0x4002_1000 for FIU0 (Master/Host)                               */
+/*         0x4002_2000 for FIU1                                             */
+/*         0x4002_3000 for FIU2                                             */
+/*==========================================================================*/
+
+typedef struct {
+	volatile uint8_t  Reserved0[1];		/*   [0x00]                                 */
+	volatile uint8_t  BURST_CFG;		/*!< [0x01] Burst Configuration             */
+	volatile uint8_t  RESP_CFG;		/*!< [0x02] FIU Response Configuration      */
+	volatile uint8_t  Reserved1[17];	/*   [0x03-0x13]                            */
+	volatile uint8_t  SPI_FL_CFG;		/*!< [0x14] SPI Flash Configuration         */
+	volatile uint8_t  Reserved2[1];		/*   [0x15]                                 */
+	volatile uint8_t  UMA_CODE;		/*!< [0x16] UMA Code Byte                   */
+	volatile uint8_t  UMA_AB0;		/*!< [0x17] UMA Address Byte 0              */
+	volatile uint8_t  UMA_AB1;		/*!< [0x18] UMA Address Byte 1              */
+	volatile uint8_t  UMA_AB2;		/*!< [0x19] UMA Address Byte 2              */
+	volatile uint8_t  UMA_DB0;		/*!< [0x1A] UMA Data Byte 0                 */
+	volatile uint8_t  UMA_DB1;		/*!< [0x1B] UMA Data Byte 1                 */
+	volatile uint8_t  UMA_DB2;		/*!< [0x1C] UMA Data Byte 2                 */
+	volatile uint8_t  UMA_DB3;		/*!< [0x1D] UMA Data Byte 3                 */
+	volatile uint8_t  UMA_CTS;		/*!< [0x1E] UMA Control and Status          */
+	volatile uint8_t  UMA_ECTS;		/*!< [0x1F] UMA Extended Control and Status */
+	volatile const uint32_t UMA_DB0_3;	/*!< [0x20] UMA Data Bytes 0-3 (RO)        */
+	volatile uint8_t  Reserved3[2];		/*   [0x24-0x25]                            */
+	volatile uint8_t  CRCCON;		/*!< [0x26] CRC Control Register            */
+	volatile uint8_t  CRCENT;		/*!< [0x27] CRC Entry Register              */
+	volatile uint32_t CRCRSLT;		/*!< [0x28] CRC Init and Result (DWord)     */
+	volatile uint8_t  Reserved4[2];		/*   [0x2C-0x2D]                            */
+	volatile uint8_t  RD_CMD_BACK;		/*!< [0x2E] FIU Read Cmd for Back-up flash  */
+	volatile uint8_t  Reserved5[1];		/*   [0x2F]                                 */
+	volatile uint8_t  RD_CMD_PVT;		/*!< [0x30] FIU Read Cmd for Private flash  */
+	volatile uint8_t  RD_CMD_SHD;		/*!< [0x31] FIU Read Cmd for Shared flash   */
+	volatile uint8_t  Reserved6[1];		/*   [0x32]                                 */
+	volatile uint8_t  FIU_EXT_CFG;		/*!< [0x33] FIU Extended Configuration      */
+	volatile uint32_t UMA_AB0_3;		/*!< [0x34] UMA Address Bytes 0-3 (DWord)   */
+	volatile uint8_t  Reserved7[4];		/*   [0x38-0x3B]                            */
+	volatile uint8_t  SET_CMD_EN;		/*!< [0x3C] Set Cmd Enable in 4B addr mode  */
+	volatile uint8_t  _4B_EN;		/*!< [0x3D] 4 Byte address mode Enable      */
+	volatile uint8_t  Reserved8[3];		/*   [0x3E-0x40]                            */
+	volatile uint8_t  MI_CNT_THRSH;		/*!< [0x41] Master Inactive Counter Thresh  */
+	volatile uint8_t  FIU_MSR_STS;		/*!< [0x42] FIU Master Status               */
+	volatile uint8_t  FIU_MSR_IE_CFG;	/*!< [0x43] FIU Master IE and Config        */
+	volatile uint8_t  Q_P_EN;		/*!< [0x44] Quad Program Enable             */
+	volatile uint8_t  Reserved9[3];		/*   [0x45-0x47]                            */
+	volatile uint8_t  EXT_DB_CFG;		/*!< [0x48] Extended Data Byte Config       */
+	volatile uint8_t  DIRECT_WR_CFG;	/*!< [0x49] Direct Write Configuration      */
+	volatile uint8_t  Reserved10[6];	/*   [0x4A-0x4F]                            */
+	volatile uint32_t EXT_DB_3_0;		/*!< [0x50] Extended Data Byte 3-0 (DWord)  */
+	volatile uint32_t EXT_DB_7_4;		/*!< [0x54] Extended Data Byte 7-4 (DWord)  */
+	volatile uint32_t EXT_DB_B_8;		/*!< [0x58] Extended Data Byte B-8 (DWord)  */
+	volatile uint32_t EXT_DB_F_C;		/*!< [0x5C] Extended Data Byte F-C (DWord)  */
+} FIU_T;
+
+#define FIU_BASE_ADDR(mdl)	(0x40020000 + ((mdl) * 0x1000L))
+#define FIU0			((FIU_T *) FIU_BASE_ADDR(0))	/* Slave/Core  */
+#define FIU0_HOST		((FIU_T *) FIU_BASE_ADDR(1))	/* Master/Host */
+#define FIU1			((FIU_T *) FIU_BASE_ADDR(2))
+#define FIU2			((FIU_T *) FIU_BASE_ADDR(3))
+
+/* UMA block/unblock macros */
+#define FIU_UMA_BLOCK(fiu)	{RegSetBit((fiu)->FIU_MSR_IE_CFG, FIU_MSR_IE_CFG_UMA_BLOCK_Msk);}
+#define FIU_UMA_UNBLOCK(fiu)	{RegClrBit((fiu)->FIU_MSR_IE_CFG, FIU_MSR_IE_CFG_UMA_BLOCK_Msk);}
+
+/*--------------------------------------*/
+/* UMA_CTS fields  (offset 0x1E)       */
+/*--------------------------------------*/
+#define FIU_UMA_CTS_EXEC_DONE_Pos	(7)
+#define FIU_UMA_CTS_EXEC_DONE_Msk	(0x1 << FIU_UMA_CTS_EXEC_DONE_Pos)
+
+#define FIU_UMA_CTS_DEV_NUM_Pos		(6)
+#define FIU_UMA_CTS_DEV_NUM_Msk		(0x1 << FIU_UMA_CTS_DEV_NUM_Pos)
+
+#define FIU_UMA_CTS_RD_WR_Pos		(5)
+#define FIU_UMA_CTS_RD_WR_Msk		(0x1 << FIU_UMA_CTS_RD_WR_Pos)
+
+#define FIU_UMA_CTS_C_SIZE_Pos		(4)
+#define FIU_UMA_CTS_C_SIZE_Msk		(0x1 << FIU_UMA_CTS_C_SIZE_Pos)
+
+#define FIU_UMA_CTS_A_SIZE_Pos		(3)
+#define FIU_UMA_CTS_A_SIZE_Msk		(0x1 << FIU_UMA_CTS_A_SIZE_Pos)
+
+#define FIU_UMA_CTS_D_SIZE_Pos		(0)
+#define FIU_UMA_CTS_D_SIZE_Msk		(0x7 << FIU_UMA_CTS_D_SIZE_Pos)
+
+/*--------------------------------------*/
+/* UMA_ECTS fields (offset 0x1F)       */
+/*--------------------------------------*/
+#define FIU_UMA_ECTS_UMA_ADDR_SIZE_Pos	(4)
+#define FIU_UMA_ECTS_UMA_ADDR_SIZE_Msk	(0x7 << FIU_UMA_ECTS_UMA_ADDR_SIZE_Pos)
+
+#define FIU_UMA_ECTS_DEV_NUM_BACK_Pos	(3)
+#define FIU_UMA_ECTS_DEV_NUM_BACK_Msk	(0x1 << FIU_UMA_ECTS_DEV_NUM_BACK_Pos)
+
+#define FIU_UMA_ECTS_SW_CS2_Pos		(2)
+#define FIU_UMA_ECTS_SW_CS2_Msk		(0x1 << FIU_UMA_ECTS_SW_CS2_Pos)
+
+#define FIU_UMA_ECTS_SW_CS1_Pos		(1)
+#define FIU_UMA_ECTS_SW_CS1_Msk		(0x1 << FIU_UMA_ECTS_SW_CS1_Pos)
+
+#define FIU_UMA_ECTS_SW_CS0_Pos		(0)
+#define FIU_UMA_ECTS_SW_CS0_Msk		(0x1 << FIU_UMA_ECTS_SW_CS0_Pos)
+
+/* All CS high = deselect all */
+#define FIU_UMA_ECTS_CS_ALL_HIGH	(FIU_UMA_ECTS_SW_CS0_Msk | \
+					 FIU_UMA_ECTS_SW_CS1_Msk | \
+					 FIU_UMA_ECTS_SW_CS2_Msk)
+
