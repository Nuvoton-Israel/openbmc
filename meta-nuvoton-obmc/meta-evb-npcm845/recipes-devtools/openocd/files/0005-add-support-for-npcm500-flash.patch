From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tim Lee <chli30@nuvoton.com>
Date: Thu, 16 Apr 2026 13:54:44 +0800
Subject: [PATCH] flash/nor/nct_esio: Add support for NPCM500 series MCP
 flash programming

Add NPCM5MNX (NPCM500) series support to the nct_esio flash driver.
The NPCM500 extends the NCT6692D architecture with three FIU modules
(FIU0, FIU1, FIU2) and a different chip-select to register-role mapping:
  SHD->FIU0 CS1, BAK->FIU0 CS2, MCP->FIU2 CS0.

The NPCM500 Cortex-M7 has a different core memory map than NPCM400:
  RAM at 0x0000_0000 (1MB) instead of 0x200C_0000 (32KB Data RAM),
  Internal flash at 0xB000_0000 instead of 0x0008_0000.
A separate linker script (npcm500_flash.lds) places the flash algorithm
at 0x0002_0000 in NPCM500 RAM, and the host-side driver selects the
correct base address per chip series.

Key changes:
- New contrib/loaders/flash/nct_esio/npcm500_flash.h with register
  definitions for FIU, SCFG, HFCG, and GDMA aligned to customer spec.
- New contrib/loaders/flash/nct_esio/npcm500_fiu_flash.c flash algo
  firmware for Cortex-M7 target.
- New contrib/loaders/flash/nct_esio/npcm500_flash.lds linker script
  for NPCM500 RAM base address (0x00020000).
- Updated Makefile to build npcm500_fiu_algo.inc with NPCM500 linker.
- Updated src/flash/nor/nct_esio.h with NPCM500 base address define.
- Updated src/flash/nor/nct_esio.c with per-series algo base address
  selection and NPCM500 flash bank types.
- New tcl/board/npcm500_evb.cfg board configuration.

Upstream-Status: Inappropriate [oe-specific]

Signed-off-by: Tim Lee <chli30@nuvoton.com>
---
diff -ruN a/contrib/loaders/flash/nct_esio/Makefile b/contrib/loaders/flash/nct_esio/Makefile
--- a/contrib/loaders/flash/nct_esio/Makefile	2026-04-21 15:24:04.151859832 +0800
+++ b/contrib/loaders/flash/nct_esio/Makefile	2026-04-21 15:24:04.152859833 +0800
@@ -23,26 +23,44 @@
 OBJS_6694D_FIU       = nct6694d_fiu_flash.o
 OBJS_6694D_SPIM      = nct6694d_spim_flash.o
 
+# NPCM500 targets (FIU only, Cortex-M7)
+TARGET_NPCM500_FIU   = npcm500_fiu_algo
+OBJS_NPCM500_FIU     = npcm500_fiu_flash.o
+
 FLAGS          = -mthumb -Os -ffunction-sections -fdata-sections -g -gdwarf-3 --specs=nano.specs
 FLAGS         += -gstrict-dwarf -Wall -fno-strict-aliasing --asm
 
-CFLAGS         = -c -I. -mcpu=cortex-m4 -fpack-struct
+CFLAGS_M4      = -c -I. -mcpu=cortex-m4 -fpack-struct
+CFLAGS_M7      = -c -I. -mcpu=cortex-m7 -fpack-struct
 
 PRE_LD_FILE    = nct_esio_flash.lds
 LD_FILE        = nct_esio_flash_generated.lds
 LDFLAGS        = -Wl,-Map,lfw.map -Wl,-T$(LD_FILE) -nostartfiles
 
-all: $(TARGET_6692D_FIU).inc $(TARGET_6694D_FIU).inc $(TARGET_6694D_SPIM).inc
+# NPCM500 uses a separate linker script (different RAM base address)
+PRE_LD_FILE_NPCM500 = npcm500_flash.lds
+LD_FILE_NPCM500     = npcm500_flash_generated.lds
+LDFLAGS_NPCM500     = -Wl,-Map,lfw.map -Wl,-T$(LD_FILE_NPCM500) -nostartfiles
+
+all: $(TARGET_6692D_FIU).inc $(TARGET_6694D_FIU).inc $(TARGET_6694D_SPIM).inc $(TARGET_NPCM500_FIU).inc
 
 # Implicit rules
+npcm500_%.o: npcm500_%.c
+	-@ echo CC $@ from $<
+	@$(CC) $< $(FLAGS) $(CFLAGS_M7) -o $@
+
 %.o: %.c
 	-@ echo CC $@ from $<
-	@$(CC) $< $(FLAGS) $(CFLAGS) -o $@
+	@$(CC) $< $(FLAGS) $(CFLAGS_M4) -o $@
 
 $(LD_FILE): $(PRE_LD_FILE)
 	-@ echo Generate $@ from $<
 	-@$(CPP) $(PRE_LD_FILE) | grep -v '^#' >>$(LD_FILE)
 
+$(LD_FILE_NPCM500): $(PRE_LD_FILE_NPCM500)
+	-@ echo Generate $@ from $<
+	-@$(CPP) $(PRE_LD_FILE_NPCM500) | grep -v '^#' >>$(LD_FILE_NPCM500)
+
 # NCT6692D FIU target
 $(TARGET_6692D_FIU).elf: $(OBJS_6692D_FIU) $(LD_FILE)
 	-@ echo LD  $@ from $<
@@ -58,6 +76,11 @@
 	-@ echo LD  $@ from $<
 	@$(LD) -o $@ $< $(FLAGS) $(LDFLAGS)
 
+# NPCM500 FIU target (uses NPCM500-specific linker script)
+$(TARGET_NPCM500_FIU).elf: $(OBJS_NPCM500_FIU) $(LD_FILE_NPCM500)
+	-@ echo LD  $@ from $<
+	@$(LD) -o $@ $< $(FLAGS) $(LDFLAGS_NPCM500)
+
 %.bin: %.elf
 	-@ echo OBJCOPY $@ from $<
 	-@ $(OBJCOPY) $< -O binary $@
@@ -76,6 +99,7 @@
 	rm -rf *.inc *.bin *.elf *.map
 	rm -rf *.o *.d
 	rm -rf $(LD_FILE)
+	rm -rf $(LD_FILE_NPCM500)
 	@echo 'Finished clean'
 	@echo ' '
 
