+set _TARGETNAME $_CHIPNAME.cpu
+$_TARGETNAME configure -work-area-phys 0x200C0000 -work-area-size 0x8000 -work-area-backup 0
+
+# flash configuration
+set _FLASHNAME $_CHIPNAME.internal.flash
+flash bank $_FLASHNAME nct_esio 0x00080000 0x10000 0 0 $_TARGETNAME $_CHIPNAME
