From e899b5f2a56323fbd8cd2897316ffceed00d3c3f Mon Sep 17 00:00:00 2001
From: Joseph Liu <kwliu@nuvoton.com>
Date: Mon, 12 May 2025 16:22:54 +0800
Subject: [PATCH] arm64: dts: nuvoton-npcm845: set gpio96 defaule high

Upstream-Status: Pending [Not submitted to upstream yet]
Signed-off-by: Joseph Liu <kwliu@nuvoton.com>
---
 .../boot/dts/nuvoton/nuvoton-npcm845-evb.dts  | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
index 2f3730f4814f..99c5f4048758 100644
--- a/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
+++ b/arch/arm64/boot/dts/nuvoton/nuvoton-npcm845-evb.dts
@@ -722,7 +722,24 @@ &pin5_slew
 			&pin6_slew
 			&pin7_slew
 			&pin108_slew
-			&pin109_slew>;
+			&pin109_slew
+			&pin96_oh>;
+
+		pin96_oh: pin96_oh {
+			pins = "GPIO96/CP1_GPIO7/TP_GPIO7";
+			bias-disable;
+			output-high;
+		};
+
+		gpio3: gpio@f0013000 {
+			/* SMC_FORCE_DL=gpio96 */
+			gpio-line-names =
+			/*96-127*/
+			"SMC_FORCE_DL","","","","","","","",
+			"","","","","","","","",
+			"","","","","","","","",
+			"","","","","","","","";
+		};
 };
 
 &vcd {
