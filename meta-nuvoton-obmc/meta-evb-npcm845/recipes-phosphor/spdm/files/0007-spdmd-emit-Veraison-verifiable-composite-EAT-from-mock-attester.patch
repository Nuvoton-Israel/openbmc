@@ -61,4 +61,27 @@ inline constexpr std::uint64_t kCfSpdmVca = 65002;
 std::vector<std::uint8_t> buildClaimsSet(const CollectedEvidence& ev,
                                          bool typedValues = false);
 
+/// RFC 9711 / draft-ietf-rats-msg-wrap CMW claim key carrying a Record CMW.
+inline constexpr std::int64_t kClaimCmw = 299;
+/// CMW indicator bit for Evidence.
+inline constexpr std::uint64_t kCmwIndicatorEvidence = 4;
+/// Media type of the native SPDM evidence record
+/// [signed_measurements, cert_chain, ?vca] carried in a Record CMW.
+inline constexpr const char* kMediaTypeSpdmEvidence =
+    "application/spdm-evidence+cbor";
+
+/// Build the detached Claims-Set as a single Record CMW claim:
+///   { 299: [ media-type, bstr native-evidence, 4 (Evidence) ] }
+///
+///   Pattern A / C -> media-type "application/spdm-evidence+cbor", value is
+///                    the deterministic CBOR array
+///                    [ signed_measurements, cert_chain, ?vca ].
+///   Pattern B     -> media-type is the device token format, value is the
+///                    device token bytes verbatim.
+///
+/// The evidence bytes are carried unmodified; the BMC still never parses
+/// or re-authors device evidence.
+/// @throws std::invalid_argument on empty required fields.
+std::vector<std::uint8_t> buildCmwClaimsSet(const CollectedEvidence& ev);
+
 } // namespace spdmd::composite
