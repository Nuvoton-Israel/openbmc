+std::vector<std::uint8_t> cmwRecordClaimsSet(std::string_view mediaType,
+                                             std::span<const std::uint8_t> value)
+{
+    std::vector<std::vector<std::uint8_t>> record;
+    record.push_back(cbor::textVal(mediaType));
+    record.push_back(cbor::bytesVal(value));
+    record.push_back(cbor::uintVal(kCmwIndicatorEvidence));
+
+    cbor::Map m;
+    m.addInt(kClaimCmw, cbor::arrayVal(record));
+    return m.encode();
+}
+
 } // namespace
 
+std::vector<std::uint8_t> buildCmwClaimsSet(const CollectedEvidence& ev)
+{
+    switch (ev.pattern)
+    {
+        case EvidencePattern::SpdmMeasurements:
+        {
+            if (ev.signedMeasurements.empty())
+            {
+                throw std::invalid_argument(
+                    "buildCmwClaimsSet: signed_measurements is empty");
+            }
+            if (ev.certificateChainDer.empty())
+            {
+                throw std::invalid_argument(
+                    "buildCmwClaimsSet: cert_chain is empty");
+            }
+            if (ev.includeVca && ev.vca.empty())
+            {
+                throw std::invalid_argument(
+                    "buildCmwClaimsSet: vca is required");
+            }
+            std::vector<std::vector<std::uint8_t>> fields;
+            fields.push_back(cbor::bytesVal(ev.signedMeasurements));
+            fields.push_back(cbor::bytesVal(ev.certificateChainDer));
+            if (ev.includeVca)
+            {
+                fields.push_back(cbor::bytesVal(ev.vca));
+            }
+            return cmwRecordClaimsSet(kMediaTypeSpdmEvidence,
+                                      cbor::arrayVal(fields));
+        }
+        case EvidencePattern::DeviceEat:
+            if (ev.deviceTokenFormat.empty())
+            {
+                throw std::invalid_argument(
+                    "buildCmwClaimsSet: token_format is empty");
+            }
+            if (ev.deviceToken.empty())
+            {
+                throw std::invalid_argument(
+                    "buildCmwClaimsSet: device_token is empty");
+            }
+            return cmwRecordClaimsSet(ev.deviceTokenFormat, ev.deviceToken);
+    }
+    throw std::invalid_argument("buildCmwClaimsSet: unknown pattern");
+}
