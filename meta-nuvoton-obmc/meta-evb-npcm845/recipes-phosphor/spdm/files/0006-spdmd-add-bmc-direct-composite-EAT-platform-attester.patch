diff --git a/spdmd/bmc_direct/bmc_direct_composite_eat_transport.hpp b/spdmd/bmc_direct/bmc_direct_composite_eat_transport.hpp
new file mode 100644
index 0000000..ed86f9e
--- /dev/null
+++ b/spdmd/bmc_direct/bmc_direct_composite_eat_transport.hpp
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 spdm contributors
+
+#pragma once
+
+#include "request_encoder.hpp"
+
+#include <cstdint>
+#include <memory>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace spdmd::bmc_direct
+{
+
+struct BmcDirectCompositeEatTransportResult
+{
+    std::vector<std::uint8_t> response;
+    std::uint32_t status = 0;
+    std::uint32_t requiredResponseSize = 0;
+    bool success = false;
+    std::string errorMsg;
+};
+
+class BmcDirectCompositeEatSyscalls
+{
+  public:
+    virtual ~BmcDirectCompositeEatSyscalls() = default;
+    virtual int open(const char* path, int flags) = 0;
+    virtual int ioctl(int fd, unsigned long request, void* argument) = 0;
+    virtual int close(int fd) = 0;
+};
+
+class BmcDirectCompositeEatTransport
+{
+  public:
+    explicit BmcDirectCompositeEatTransport(
+        std::string devicePath = "/dev/npcm-composite-eat",
+        std::shared_ptr<BmcDirectCompositeEatSyscalls> syscalls = {});
+    virtual ~BmcDirectCompositeEatTransport();
+
+    BmcDirectCompositeEatTransport(const BmcDirectCompositeEatTransport&) = delete;
+    BmcDirectCompositeEatTransport& operator=(const BmcDirectCompositeEatTransport&) = delete;
+    BmcDirectCompositeEatTransport(BmcDirectCompositeEatTransport&&) = delete;
+    BmcDirectCompositeEatTransport& operator=(BmcDirectCompositeEatTransport&&) = delete;
+
+    virtual bool isReady() const;
+    virtual BmcDirectCompositeEatTransportResult
+        submit(std::span<const std::uint8_t> request,
+               std::size_t responseCapacity = kMaxResponseSize);
+
+  private:
+    std::shared_ptr<BmcDirectCompositeEatSyscalls> syscalls;
+    int fd = -1;
+    std::string openError;
+};
+
+} // namespace spdmd::bmc_direct
