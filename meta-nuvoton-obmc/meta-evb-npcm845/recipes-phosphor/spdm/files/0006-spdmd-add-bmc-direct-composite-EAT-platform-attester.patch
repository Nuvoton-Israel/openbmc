diff --git a/spdmd/bmc_direct/bmc_direct_platform_attester.cpp b/spdmd/bmc_direct/bmc_direct_platform_attester.cpp
new file mode 100644
index 0000000..f8c1a42
--- /dev/null
+++ b/spdmd/bmc_direct/bmc_direct_platform_attester.cpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 spdm contributors
+
+#include "bmc_direct_platform_attester.hpp"
+
+#include "request_encoder.hpp"
+
+#include <exception>
+#include <utility>
+
+namespace spdmd::bmc_direct
+{
+
+BmcDirectPlatformAttester::BmcDirectPlatformAttester() :
+    BmcDirectPlatformAttester(
+        std::make_unique<BmcDirectCompositeEatTransport>())
+{}
+
+BmcDirectPlatformAttester::BmcDirectPlatformAttester(
+    std::unique_ptr<BmcDirectCompositeEatTransport> compositeEatTransport) :
+    transport(std::move(compositeEatTransport))
+{}
+
+composite::CompositeEatResponse BmcDirectPlatformAttester::generateCompositeEat(
+    const composite::CompositeEatRequest& request)
+{
+    composite::CompositeEatResponse result;
+    if (getStatus() != PlatformAttesterStatus::Ready)
+    {
+        result.errorMsg = "BMC_DIRECT Platform Attester is offline";
+        return result;
+    }
+
+    std::vector<std::uint8_t> encoded;
+    try
+    {
+        encoded = encodeRequest(request);
+    }
+    catch (const std::exception& error)
+    {
+        result.errorMsg = error.what();
+        return result;
+    }
+
+    BmcDirectCompositeEatTransportResult transportResult =
+        transport->submit(encoded);
+    if (!transportResult.success)
+    {
+        result.errorMsg = std::move(transportResult.errorMsg);
+        return result;
+    }
+
+    result.compositeEat = std::move(transportResult.response);
+    result.success = true;
+    return result;
+}
+
+PlatformAttesterStatus BmcDirectPlatformAttester::getStatus() const
+{
+    return (transport && transport->isReady())
+               ? PlatformAttesterStatus::Ready
+               : PlatformAttesterStatus::Unavailable;
+}
+
+} // namespace spdmd::bmc_direct
