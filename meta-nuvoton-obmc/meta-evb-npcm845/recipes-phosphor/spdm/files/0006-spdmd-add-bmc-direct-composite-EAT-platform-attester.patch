diff --git a/spdmd/bmc_direct/bmc_direct_composite_eat_transport.cpp b/spdmd/bmc_direct/bmc_direct_composite_eat_transport.cpp
new file mode 100644
index 0000000..342394e
--- /dev/null
+++ b/spdmd/bmc_direct/bmc_direct_composite_eat_transport.cpp
@@ -0,0 +1,140 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 spdm contributors
+
+#include "bmc_direct_composite_eat_transport.hpp"
+
+#include <fcntl.h>
+#include <linux/npcm-composite-eat.h>
+#include <sys/ioctl.h>
+#include <unistd.h>
+
+#include <cerrno>
+#include <cstring>
+#include <limits>
+#include <string_view>
+
+namespace spdmd::bmc_direct
+{
+
+namespace
+{
+
+static_assert(sizeof(npcm_composite_eat_io) == 48);
+
+class LinuxBmcDirectCompositeEatSyscalls : public BmcDirectCompositeEatSyscalls
+{
+  public:
+    int open(const char* path, int flags) override
+    {
+        return ::open(path, flags);
+    }
+
+    int ioctl(int fd, unsigned long request, void* argument) override
+    {
+        return ::ioctl(fd, request, argument);
+    }
+
+    int close(int fd) override
+    {
+        return ::close(fd);
+    }
+};
+
+std::string systemError(std::string_view operation, int error)
+{
+    return std::string{operation} + ": " + std::strerror(error);
+}
+
+} // namespace
+
+BmcDirectCompositeEatTransport::BmcDirectCompositeEatTransport(
+    std::string devicePath,
+    std::shared_ptr<BmcDirectCompositeEatSyscalls> calls) :
+    syscalls(calls ? std::move(calls)
+                   : std::make_shared<LinuxBmcDirectCompositeEatSyscalls>())
+{
+    fd = syscalls->open(devicePath.c_str(), O_RDWR | O_CLOEXEC);
+    if (fd < 0)
+    {
+        openError = systemError("open " + devicePath, errno);
+    }
+}
+
+BmcDirectCompositeEatTransport::~BmcDirectCompositeEatTransport()
+{
+    if (fd >= 0)
+    {
+        syscalls->close(fd);
+    }
+}
+
+bool BmcDirectCompositeEatTransport::isReady() const
+{
+    return fd >= 0;
+}
+
+BmcDirectCompositeEatTransportResult BmcDirectCompositeEatTransport::submit(
+    std::span<const std::uint8_t> request, std::size_t responseCapacity)
+{
+    BmcDirectCompositeEatTransportResult result;
+    if (!isReady())
+    {
+        result.errorMsg = openError;
+        return result;
+    }
+    if (request.empty() || request.size() > kMaxRequestSize)
+    {
+        result.errorMsg = "composite EAT request length must be in 1..4096";
+        return result;
+    }
+    if (responseCapacity == 0 || responseCapacity > kMaxResponseSize ||
+        responseCapacity > std::numeric_limits<std::uint32_t>::max())
+    {
+        result.errorMsg = "composite EAT response capacity must be in 1..16384";
+        return result;
+    }
+
+    std::vector<std::uint8_t> response(responseCapacity);
+    npcm_composite_eat_io io{
+        .abi_version = NPCM_COMPOSITE_EAT_ABI_VERSION,
+        .reserved = 0,
+        .req_ptr = reinterpret_cast<std::uintptr_t>(request.data()),
+        .req_len = static_cast<std::uint32_t>(request.size()),
+        .reserved_req = 0,
+        .resp_ptr = reinterpret_cast<std::uintptr_t>(response.data()),
+        .resp_cap = static_cast<std::uint32_t>(response.size()),
+        .resp_len = 0,
+        .status = 0,
+        .reserved_resp = 0,
+    };
+
+    if (syscalls->ioctl(fd, NPCM_COMPOSITE_EAT_GENERATE, &io) < 0)
+    {
+        result.errorMsg = systemError("NPCM_COMPOSITE_EAT_GENERATE", errno);
+        return result;
+    }
+
+    result.status = io.status;
+    result.requiredResponseSize = io.resp_len;
+    if (io.status != NPCM_COMPOSITE_EAT_STATUS_OK)
+    {
+        result.errorMsg = "composite EAT generation failed with status " +
+                          std::to_string(io.status) + ", response length " +
+                          std::to_string(io.resp_len);
+        return result;
+    }
+    if (io.resp_len == 0 || io.resp_len > response.size())
+    {
+        result.errorMsg =
+            "composite EAT service returned invalid successful response length " +
+            std::to_string(io.resp_len);
+        return result;
+    }
+
+    response.resize(io.resp_len);
+    result.response = std::move(response);
+    result.success = true;
+    return result;
+}
+
+} // namespace spdmd::bmc_direct
