diff --git a/spdmd/bmc_direct/request_encoder.cpp b/spdmd/bmc_direct/request_encoder.cpp
new file mode 100644
index 0000000..d4899e4
--- /dev/null
+++ b/spdmd/bmc_direct/request_encoder.cpp
@@ -0,0 +1,87 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 spdm contributors
+
+#include "request_encoder.hpp"
+
+#include "composite/cbor_det.hpp"
+#include "composite/collection_plan.hpp"
+
+#include <stdexcept>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+namespace spdmd::bmc_direct
+{
+
+namespace
+{
+
+constexpr std::uint64_t kAbiVersion = 1;
+std::vector<std::uint8_t> encodeRecord(const composite::SubmoduleRecord& record)
+{
+    if (!composite::CollectionPlan::isValidEnvId(record.environmentId))
+    {
+        throw std::invalid_argument(
+            "composite EAT environment ID must match the env.* grammar");
+    }
+    if (record.hashAlgId != composite::kCoseAlgSha384)
+    {
+        throw std::invalid_argument(
+            "composite EAT device record digest algorithm must be COSE SHA-384 (-43)");
+    }
+
+    std::vector<std::vector<std::uint8_t>> digest;
+    digest.push_back(composite::cbor::intVal(record.hashAlgId));
+    digest.push_back(composite::cbor::bytesVal(record.digest));
+
+    composite::cbor::Map encoded;
+    encoded.addInt(1, composite::cbor::textVal(record.environmentId));
+    encoded.addInt(2, composite::cbor::arrayVal(digest));
+    return encoded.encode();
+}
+
+} // namespace
+
+std::vector<std::uint8_t>
+    encodeRequest(const composite::CompositeEatRequest& request)
+{
+    if (request.deviceRecords.empty() ||
+        request.deviceRecords.size() > kMaxDeviceRecords)
+    {
+        throw std::invalid_argument(
+            "composite EAT request requires 1..64 device records");
+    }
+    if (request.platformCorimLocator)
+    {
+        throw std::invalid_argument(
+            "BMC_DIRECT composite EAT ABI v1 does not support a Platform CoRIM locator");
+    }
+
+    std::vector<std::vector<std::uint8_t>> records;
+    records.reserve(request.deviceRecords.size());
+    std::unordered_set<std::string> environmentIds;
+    for (const auto& record : request.deviceRecords)
+    {
+        if (!environmentIds.insert(record.environmentId).second)
+        {
+            throw std::invalid_argument(
+                "composite EAT request contains a duplicate environment ID");
+        }
+        records.push_back(encodeRecord(record));
+    }
+
+    composite::cbor::Map encoded;
+    encoded.addInt(1, composite::cbor::uintVal(kAbiVersion));
+    encoded.addInt(2, composite::cbor::bytesVal(request.nonce));
+    encoded.addInt(3, composite::cbor::arrayVal(records));
+
+    std::vector<std::uint8_t> result = encoded.encode();
+    if (result.size() > kMaxRequestSize)
+    {
+        throw std::length_error("composite EAT request exceeds 4096 bytes");
+    }
+    return result;
+}
+
+} // namespace spdmd::bmc_direct
