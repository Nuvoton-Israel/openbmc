+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+/*
+ * This file deliberately avoids <termios.h>: the termios2 interface lives in
+ * <asm/termbits.h>, whose definitions conflict with the libc ones.
+ */
+#include <asm/termbits.h>
+#include <sys/ioctl.h>
+
+#include "tty-baud.h"
+
+int tty_set_baud(int fd, uint32_t baud)
+{
+	struct termios2 tio;
+
+	if (!baud) {
+		return -1;
+	}
+
+	if (ioctl(fd, TCGETS2, &tio) < 0) {
+		return -1;
+	}
+
+	/* BOTHER takes the rate from c_ispeed/c_ospeed rather than a Bxxx code,
+	 * which allows non-standard rates such as 134400. */
+	tio.c_cflag &= ~(CBAUD | (CBAUD << IBSHIFT));
+	tio.c_cflag |= BOTHER | (BOTHER << IBSHIFT);
+	tio.c_ispeed = baud;
+	tio.c_ospeed = baud;
+
+	return ioctl(fd, TCSETS2, &tio) < 0 ? -1 : 0;
+}
