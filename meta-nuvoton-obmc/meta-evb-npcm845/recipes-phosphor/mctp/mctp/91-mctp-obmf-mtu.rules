# The OBMF I2C Controller channel carries one MCTP packet per OBMF request.
# SMC1 advertises a 252-byte MAX_REQUEST_PAYLOAD_SIZE (OBMF-ICP 1.0.0
# Section 5.15, Table 65), so the default MCTP-over-I2C MTU of 254 produces
# 258-byte writes that the driver refuses. The mctpi2c* and mctpi3c2
# interfaces appear only after the OBMF driver registers its channels and
# are recreated whenever SMC1 re-enumerates, while mctp-config runs only
# once when mctpd starts. Set the MTU and bring the link up when the
# interface is added; the local EID already lives on mctpusb0.
ACTION=="add", SUBSYSTEM=="net", KERNEL=="mctpi2c*", KERNELS=="1-1:1.1", \
  RUN+="/bin/sh -c '/usr/bin/mctp link set %k mtu 240; /usr/bin/mctp link set %k up'"
ACTION=="add", SUBSYSTEM=="net", KERNEL=="mctpi3c2", \
  RUN+="/bin/sh -c '/usr/bin/mctp link set %k mtu 240; /usr/bin/mctp link set %k up'"
