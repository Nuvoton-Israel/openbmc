+	}
+
+	if (strcmp(argv[1], "manual") == 0) {
+		ulong addr;
+		ulong len;
+
+		addr = hextoul(argv[2], NULL);
+		len = hextoul(argv[3], NULL);
+
+		nuvoton = (char *)addr;
+
+		for ( i = 0; i < len; i++) {
+			sprintf(&data, "%c", nuvoton[i]);
+			espi_put_iowr(0x3f8, &data, 1, resp);
+			udelay(100);
+			if (ctrlc())
+				break;
+		}
+
+
+		return 0;
+	}
+
+	return 0;
+
+}
