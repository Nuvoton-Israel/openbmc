+			return 0;
+		}
+
+		if (count-- == 0) {
+			printf("\nwait_for_pc_avail timeout\n");
+			return -ETIMEDOUT;
+		}
+		//udelay(100);
+		udelay(1);
+	} while (1);
+
+	return -ETIMEDOUT;
+}
