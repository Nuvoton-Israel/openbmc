+static int espi_flash_read(u32 addr, int count, u32 dest)
+{
+	int i, index = 0, len;
+	static ulong time_start;
+
+	time_start = get_timer(0);
+
+	printf("Load address: 0x%x\n", dest);
+	puts("Loading: *\b");
+
+	index = count /FLASH_R_LENGTH;
+	if (count % FLASH_R_LENGTH)
+		index++;
+
+	for (i = 0; i < index; i ++) {
+		if ((i == index - 1) && (count % FLASH_R_LENGTH))
+			len = count % FLASH_R_LENGTH;
+		else
+			len = FLASH_R_LENGTH;
+
+		if (espi_put_flash_np(CYCLE_FLASH_READ, addr + i * FLASH_R_LENGTH, len, 0))
+			return STATUS_ERR;
+
+		if (wait_alert())
+			return STATUS_ERR;
+
+		if (wait_for_flash_c_avail())
+			return STATUS_ERR;
+
+		if (espi_get_flash_c(len, dest + i * FLASH_R_LENGTH))
+			return STATUS_ERR;
+
+		//status = espi_get_status();
+		//printf("status = 0x%x\n", status);
+		putc('#');
+		if ((i % FLASH_R_LENGTH) == 0 && i > 0)
+			puts("\n\t ");
+
+		//udelay(20);
+	}
+	time_start = get_timer(time_start);
+	if (time_start > 0) {
+		puts("\n\t ");	/* Line up with "Loading: " */
+		print_size(count / time_start * 1000, "/s");
+	}
+
+	printf("\ndone\n");
+
+	return STATUS_OK;
+}
+
+static int espi_flash_write(u32 addr, int count, u32 data_addr)
+{
+	int i, index = 0, len;
+	static ulong time_start;
+	//u32 *data = (u32 *)(uintptr_t)data_addr;
+
+	time_start = get_timer(0);
+
+	printf("Save mem address 0x%x to flash address 0x%x\n", data_addr, addr);
+	printf("Saving..\n");
+
+	index = count /FLASH_R_LENGTH;
+	if (count % FLASH_R_LENGTH)
+		index++;
+
+	for (i = 0; i < index; i ++) {
+		if ((i == index - 1) && (count % FLASH_R_LENGTH))
+			len = count % FLASH_R_LENGTH;
+		else
+			len = FLASH_R_LENGTH;
+
+		if (espi_put_flash_np(CYCLE_FLASH_WRITE, addr + i * FLASH_R_LENGTH, len, data_addr))
+			return STATUS_ERR;
+
+		if (wait_alert())
+			return STATUS_ERR;
+
+		if (wait_for_flash_c_avail())
+			return STATUS_ERR;
+
+		if (espi_get_flash_c(0, 0))
+			return STATUS_ERR;
+
+		data_addr += len;
+		putc('#');
+		if ((i % FLASH_R_LENGTH) == 0 && i > 0)
+			puts("\n\t ");
+	}
+	time_start = get_timer(time_start);
+	if (time_start > 0) {
+		puts("\n\t ");	/* Line up with "Loading: " */
+		print_size(count / time_start * 1000, "/s");
+	}
+
+	printf("\ndone\n");
+
+	return STATUS_OK;
+}
