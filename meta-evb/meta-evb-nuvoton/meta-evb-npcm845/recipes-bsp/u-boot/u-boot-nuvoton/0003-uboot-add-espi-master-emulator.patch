+static int do_kcs_test(void)
+{
+	u8 req[2];
+	u8 resp[32];
+	int read_len;
+	int i;
+	bool debug_save = debug;
+
+	/* get device id */
+	req[0] = 0x18;
+	req[1] = 1;
+	debug = false;
+	read_len = kcs_transfer(req, 2, resp, 18);
+	debug = debug_save;
+
+	if (read_len < 0) {
+		printf("kcs transfer err\n");
+		return 0;
+	}
+	for (i = 0; i < read_len; i++)
+		printf("%02x ", resp[i]);
+	printf("\n");
+
+	return 0;
+}
