+static int espi_flash_erase(u32 addr)
+{
+	u16 status;
+	int loop = 1000000;
+
+	static ulong time_start;
+
+	time_start = get_timer(0);
+
+	printf("Erase address: 0x%x\n", addr);
+
+	time_start = get_timer(time_start);
+	do {
+		status = espi_get_status();
+		if (status & BIT(9)) {
+			break;
+		}
+
+		if (loop-- == 0) {
+			printf("\%s:wait for FLASH_NP_FREE timeout\n", __func__);
+			return -ETIMEDOUT;
+		}
+		udelay(1);
+	} while (1);
+
+	if (espi_put_flash_np(CYCLE_FLASH_ERASE, addr, 0, 0))
+		return STATUS_ERR;
+
+	if (wait_alert())
+		return STATUS_ERR;
+
+	if (wait_for_flash_c_avail())
+		return STATUS_ERR;
+
+	if (espi_get_flash_c(0, 0))
+		return STATUS_ERR;
+
+	printf("\ndone\n");
+
+	return STATUS_OK;
+}
